{
    "custom": {
        "threadStarts": {
            "name": "thread_starts",
            "type": "counter",
            "help": "Number of started threads",
            "labelNames": []
        },
        "threadStops": {
            "name": "thread_stops",
            "type": "counter",
            "help": "Number of stopped threads",
            "labelNames": []
        },
        "apiCall": {
            "name": "api_call",
            "type": "counter",
            "help": "Number of API calls",
            "labelNames": [
                "method",
                "statusCode",
                "route"
            ]
        },
        "apiCallDuration": {
            "name": "api_call_duration_seconds",
            "type": "histogram",
            "help": "Duration of API calls, from receiving the request to sending the response",
            "labelNames": [
                "method",
                "route"
            ],
            "buckets": [
                0.005,
                0.01,
                0.025,
                0.05,
                0.1,
                0.25,
                0.5,
                1,
                2.5,
                5,
                10,
                30,
                60
            ]
        },
