#: views/oauth-scope-error.hbs:10
msgid ""
"Some permissions were not granted during sign-in. This service needs all the "
"requested permissions to work."
msgstr ""
"Några behörigheter beviljades inte vid inloggningen. Tjänsten behöver alla "
"begärda behörigheter för att fungera."

#: views/oauth-scope-error.hbs:14
msgid "The following permissions were not granted:"
msgstr "Följande behörigheter saknas:"

#: views/oauth-scope-error.hbs:23
msgid "Please try again and make sure all permission checkboxes are selected on the Google consent screen."
msgstr "Försök igen och se till att alla kryssrutor för behörigheter är markerade på Googles godkännandesida."

#: views/partials/public_test_labels.hbs:9
