msgid "Enter server settings manually"
msgstr "Ange serverinställningarna manuellt"

#: views/accounts/register/validating.hbs:53
msgid "We couldn't sign in to your mail server"
msgstr "Vi kunde inte logga in på din e-postserver"

#: views/accounts/register/validating.hbs:54
msgid "Check the settings on the next page and try again."
msgstr "Kontrollera inställningarna på nästa sida och försök igen."

#: views/accounts/register/validating.hbs:61
msgid "Continue to server settings"
msgstr "Fortsätt till serverinställningarna"

#: views/accounts/register/validating.hbs:69
msgid "Almost there"
msgstr "Nästan klart"

#: views/accounts/register/validating.hbs:70
msgid "Continue to review your mail server settings."
msgstr "Gå vidare för att se över inställningarna för din e-postserver."

#: views/accounts/register/validating.hbs:74
#: views/accounts/register/imap.hbs:55
msgid "Continue"
msgstr "Fortsätt"

#: views/accounts/register/imap.hbs:13
msgid "Your name"
msgstr "Ditt namn"

#: views/accounts/register/imap.hbs:19
msgid "Enter your full name"
msgstr "Ange ditt fullständiga namn"

#: views/accounts/register/imap.hbs:35
msgid "This setup link is restricted to this email address"
msgstr "Länken kan bara användas för den här e-postadressen"

#: views/accounts/register/imap.hbs:37
msgid "Enter your email address"
msgstr "Ange din e-postadress"

#: views/accounts/register/imap.hbs:43
#: views/accounts/register/imap-server.hbs:58
#: views/accounts/register/imap-server.hbs:165
msgid "Password"
msgstr "Lösenord"

#: views/accounts/register/imap.hbs:49
msgid "Enter your account password"
msgstr "Ange lösenordet för ditt konto"

#: views/accounts/register/imap-server.hbs:23
msgid ""
"Server settings could not be detected automatically for %s. Enter them below."
msgstr ""
"Serverinställningarna för %s kunde inte hittas automatiskt. Ange dem nedan."

#: views/accounts/register/imap-server.hbs:34
msgid ""
"We couldn't sign in to your mail server with those settings. Check them and "
"try again."
msgstr ""
"Vi kunde inte logga in på din e-postserver med de inställningarna. "
"Kontrollera dem och försök igen."

