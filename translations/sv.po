msgid "This link is not valid. Use the unsubscribe link from the email you received."
msgstr "Länken är inte giltig. Använd avregistreringslänken i e-postmeddelandet du fick."

#: workers/api.js:1773
msgid "The sign-in was cancelled or the requested access was not granted. Open the account setup link again to retry."
msgstr "Inloggningen avbröts eller så fick tjänsten inte den begärda åtkomsten. Öppna länken för att ansluta kontot igen och försök på nytt."

#: workers/api.js:1782
msgid "Sign-in with the email provider failed: %s"
msgstr "Inloggningen hos e-postleverantören misslyckades: %s"

#: workers/api.js:1786
msgid "Sign-in with the email provider failed: no authorization code was received"
msgstr "Inloggningen hos e-postleverantören misslyckades: ingen auktoriseringskod togs emot"

#: workers/api.js:1790
msgid "Sign-in with the email provider failed: the request state is not valid"
msgstr "Inloggningen hos e-postleverantören misslyckades: begärans state-värde är ogiltigt"

#: workers/api.js:1799
msgid "The account setup session has expired or was already used. Open the account setup link again to retry."
msgstr "Sessionen för att ansluta kontot har gått ut eller har redan använts. Öppna länken för att ansluta kontot igen och försök på nytt."

#: workers/api.js:1805
msgid "Sign-in with the email provider failed: the stored setup session is not valid"
msgstr "Inloggningen hos e-postleverantören misslyckades: den sparade sessionen för att ansluta kontot är ogiltig"

#: workers/api.js:2499 workers/api.js:2622
msgid "Requested page not found"
msgstr "Sidan kunde inte hittas"
