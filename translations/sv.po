msgid "Unsubscribe"
msgstr "Avsluta prenumeration"

#: views/unsubscribe.hbs:9
msgid "You have been unsubscribed."
msgstr "Din e-postadress har avregistrerats."

#: views/unsubscribe.hbs:11
msgid "Unsubscribed by mistake? <a%s>Subscribe again</a>."
msgstr "Avslutade du prenumerationen av misstag? <a%s>Prenumerera igen</a>."

#: views/unsubscribe.hbs:18
msgid "Subscribe again"
msgstr "Prenumerera igen"

#: views/unsubscribe.hbs:24
