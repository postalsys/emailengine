msgid ""
"The sign-in was cancelled or the requested access was not granted. Open the "
"account setup link again to retry."
msgstr ""
"Sisselogimine tühistati või taotletud juurdepääsu ei antud. Avage konto "
"seadistamise link uuesti, et proovida uuesti."

#: workers/api.js:2240
msgid "Sign-in with the email provider failed: %s"
msgstr "Sisselogimine e-posti teenusepakkuja kaudu ebaõnnestus: %s"

#: workers/api.js:2244
msgid ""
"Sign-in with the email provider failed: no authorization code was received"
msgstr ""
"Sisselogimine e-posti teenusepakkuja kaudu ebaõnnestus: autoriseerimiskoodi "
"ei saadud"

#: workers/api.js:2250
msgid "Sign-in with the email provider failed: the request state is not valid"
msgstr ""
"Sisselogimine e-posti teenusepakkuja kaudu ebaõnnestus: päringu seisund ei "
"ole kehtiv"

#: workers/api.js:2256
msgid ""
"The account setup session has expired or was already used. Open the account "
"setup link again to retry."
msgstr ""
"Konto seadistamise seanss on aegunud või seda on juba kasutatud. Avage konto "
"seadistamise link uuesti, et proovida uuesti."

#: workers/api.js:2263
msgid ""
"Sign-in with the email provider failed: the stored setup session is not valid"
msgstr ""
"Sisselogimine e-posti teenusepakkuja kaudu ebaõnnestus: salvestatud "
"seadistussessioon ei ole kehtiv"

