msgstr "Faltan los datos de acceso"

#: lib/ui-routes/account-routes.js:1120
#: lib/ui-routes/admin-entities-routes.js:2087
msgid "OAuth2 authentication failed"
msgstr "Ha fallado el inicio de sesión con OAuth2"

#: lib/ui-routes/account-routes.js:1137
