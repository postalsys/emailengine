msgstr "Inicia sesión con tu cuenta de Microsoft"

#: views/accounts/register/provider-signin.hbs:12
msgid "Sign in with your Google account"
msgstr "Inicia sesión con tu cuenta de Google"

#: views/accounts/register/provider-signin.hbs:21
msgid ""
"This appears to be a Microsoft mailbox. Sign in with Microsoft to connect "
"it. Password sign-in over IMAP is no longer supported."
msgstr ""
"Parece que este buzón está alojado en Microsoft. Inicia sesión con Microsoft "
"para conectarlo. Ya no se admite el inicio de sesión con contraseña por IMAP."

#: views/accounts/register/provider-signin.hbs:23
msgid "This appears to be a Google account. Sign in with Google to connect it."
msgstr ""
"Parece que esta es una cuenta de Google. Inicia sesión con Google para "
"conectarla."

#: views/accounts/register/provider-signin.hbs:46
msgid "Use IMAP with a password"
msgstr "Usar IMAP con contraseña"

#: views/accounts/register/provider-signin.hbs:48
msgid "Use IMAP with an app password"
msgstr "Usar IMAP con contraseña de aplicación"

#: views/accounts/register/provider-signin.hbs:53
msgid "Choose this option only if your mailbox is hosted by another provider."
msgstr "Elige esta opción solo si tu buzón está alojado en otro proveedor."

#: views/accounts/register/provider-signin.hbs:55
msgid ""
"This option requires a Google app password. Your regular password will not "
"work."
msgstr ""
"Esta opción requiere una contraseña de aplicación de Google. Tu contraseña "
"habitual no funcionará."

#: views/accounts/register/validating.hbs:35
msgid "Checking your mail server"
msgstr "Comprobando tu servidor de correo"

