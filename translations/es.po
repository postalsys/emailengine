msgstr "No se ha podido procesar la solicitud. Vuelve a intentarlo."

#: workers/api.js:2231
msgid ""
"The sign-in was cancelled or the requested access was not granted. Open the "
"account setup link again to retry."
msgstr ""
"Se ha cancelado el inicio de sesión o no se ha concedido el acceso "
"solicitado. Vuelve a abrir el enlace para conectar la cuenta e inténtalo de "
"nuevo."

#: workers/api.js:2240
msgid "Sign-in with the email provider failed: %s"
msgstr "No se ha podido iniciar sesión con el proveedor de correo: %s"

#: workers/api.js:2244
msgid ""
"Sign-in with the email provider failed: no authorization code was received"
msgstr ""
"No se ha podido iniciar sesión con el proveedor de correo: no se ha "
"recibido ningún código de autorización"

#: workers/api.js:2250
msgid "Sign-in with the email provider failed: the request state is not valid"
msgstr ""
"No se ha podido iniciar sesión con el proveedor de correo: el estado de la "
"solicitud no es válido"

#: workers/api.js:2256
msgid ""
"The account setup session has expired or was already used. Open the account "
"setup link again to retry."
msgstr ""
"La sesión para conectar la cuenta ha caducado o ya se ha usado. Vuelve a "
"abrir el enlace para conectar la cuenta e inténtalo de nuevo."

#: workers/api.js:2263
msgid ""
"Sign-in with the email provider failed: the stored setup session is not valid"
msgstr ""
"No se ha podido iniciar sesión con el proveedor de correo: la sesión "
"guardada para conectar la cuenta no es válida"

#: workers/api.js:3129 workers/api.js:3244
msgid "Requested page not found"
msgstr "No se ha encontrado la página"
