msgstr "Sin fecha de caducidad"

#: lib/ui-routes/route-helpers.js:105
msgid "The server unexpectedly closed the connection."
msgstr "El servidor ha cerrado la conexión de forma inesperada."

#: lib/ui-routes/route-helpers.js:107
msgid ""
"The server unexpectedly closed the connection. This usually happens when "
"attempting to connect to a TLS port without TLS enabled."
msgstr ""
"El servidor ha cerrado la conexión de forma inesperada. Esto suele ocurrir "
"al conectar a un puerto TLS sin tener TLS activado."

#: lib/ui-routes/route-helpers.js:162
msgid ""
"Connection timed out. This usually occurs if you are behind a firewall or "
"connecting to the wrong port."
msgstr ""
"Se ha agotado el tiempo de espera de la conexión. Suele deberse a un "
"cortafuegos que bloquea la conexión o a un puerto incorrecto."

#: lib/ui-routes/route-helpers.js:169
msgid ""
"The server refused the connection. This typically occurs if the server is "
"not running, is overloaded, or you are connecting to the wrong host or port."
msgstr ""
"El servidor ha rechazado la conexión. Suele ocurrir si está apagado o "
"sobrecargado, o si el nombre del servidor o el puerto son incorrectos."

#: lib/ui-routes/route-helpers.js:223
msgid "Delegated"
msgstr "Acceso delegado"

#: lib/ui-routes/route-helpers.js:224
msgid "Using credentials from \"%s\""
msgstr "Se usan los datos de acceso de la cuenta \"%s\""

#: lib/ui-routes/unsubscribe-routes.js:41
#: lib/ui-routes/unsubscribe-routes.js:167
#: lib/ui-routes/unsubscribe-routes.js:197
