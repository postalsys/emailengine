#: workers/api.js:2250
msgid "Sign-in with the email provider failed: the request state is not valid"
msgstr ""
"E-posta sağlayıcısı üzerinden oturum açılamadı: isteğin durum bilgisi "
"geçersiz"

#: workers/api.js:2256
msgid ""
"The account setup session has expired or was already used. Open the account "
"setup link again to retry."
msgstr ""
"Hesap kurulumu için açılan oturumun süresi dolmuş veya oturum zaten "
"kullanılmış. Tekrar denemek için hesap kurulum bağlantısını yeniden açın."

#: workers/api.js:2263
msgid ""
"Sign-in with the email provider failed: the stored setup session is not valid"
msgstr ""
"E-posta sağlayıcısı üzerinden oturum açılamadı: kaydedilen kurulum oturumu "
"geçersiz"

