#: lib/ui-routes/account-routes.js:658
msgid ""
"Too many attempts for this setup link. Request a new setup link to continue."
msgstr ""
"Zbyt wiele prób dla tego linku konfiguracyjnego. Aby kontynuować, poproś o "
"nowy link konfiguracyjny."

