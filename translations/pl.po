#: workers/api.js:2231
msgid ""
"The sign-in was cancelled or the requested access was not granted. Open the "
"account setup link again to retry."
msgstr ""
"Logowanie zostało anulowane lub żądany dostęp nie został przyznany. Otwórz "
"ponownie link do konfiguracji konta, aby spróbować jeszcze raz."

#: workers/api.js:2240
msgid "Sign-in with the email provider failed: %s"
msgstr "Nie udało się zalogować za pomocą dostawcy poczty e-mail: %s"

#: workers/api.js:2244
msgid ""
"Sign-in with the email provider failed: no authorization code was received"
msgstr ""
"Nie udało się zalogować za pośrednictwem dostawcy poczty e-mail: nie "
"otrzymano kodu autoryzacyjnego"

#: workers/api.js:2250
msgid "Sign-in with the email provider failed: the request state is not valid"
msgstr ""
"Nie udało się zalogować za pośrednictwem dostawcy poczty e-mail: stan "
"żądania jest nieprawidłowy"

#: workers/api.js:2256
msgid ""
"The account setup session has expired or was already used. Open the account "
"setup link again to retry."
msgstr ""
"Sesja konfiguracji konta wygasła lub została już wykorzystana. Otwórz "
"ponownie link do konfiguracji konta, aby spróbować jeszcze raz."

#: workers/api.js:2263
msgid ""
"Sign-in with the email provider failed: the stored setup session is not valid"
msgstr ""
"Nie udało się zalogować za pośrednictwem dostawcy poczty e-mail: zapisana "
"sesja konfiguracyjna jest nieprawidłowa"

#: workers/api.js:3129 workers/api.js:3244
