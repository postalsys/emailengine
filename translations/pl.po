msgstr "Instrukcje"

#: views/accounts/register/imap-server.hbs:64
#: views/accounts/register/imap-server.hbs:171
msgid "%s accounts require an application password for %s."
msgstr "Konta %s wymagają hasła aplikacji dla %s."

#: views/accounts/register/imap-server.hbs:73
#: views/accounts/register/imap-server.hbs:180
msgid "Application Password"
msgstr "Hasło aplikacji"

#: views/accounts/register/imap-server.hbs:87
#: views/accounts/register/imap-server.hbs:194
msgid "Hostname"
msgstr "Nazwa hosta"

#: views/accounts/register/imap-server.hbs:97
#: views/accounts/register/imap-server.hbs:204
msgid "Port"
msgstr "Port"

#: views/accounts/register/imap-server.hbs:112
msgid "TLS for IMAP"
msgstr "TLS dla IMAP"

#: views/accounts/register/imap-server.hbs:113
msgid ""
"TLS (also known as SSL) is usually only needed when using port 993. For "
"other ports EmailEngine falls back to using STARTTLS based encryption."
msgstr ""
"TLS (znany również jako SSL) jest zwykle potrzebny tylko w przypadku "
"korzystania z portu 993. W przypadku innych portów EmailEngine powraca do "
"szyfrowania opartego na STARTTLS."

#: views/accounts/register/imap-server.hbs:120
#: views/accounts/register/imap-server.hbs:227
msgid "Use TLS"
msgstr "Użyj TLS"

#: views/accounts/register/imap-server.hbs:129
msgid "SMTP"
msgstr "SMTP"

#: views/accounts/register/imap-server.hbs:219
msgid "TLS for SMTP"
msgstr "TLS dla SMTP"

#: views/accounts/register/imap-server.hbs:220
msgid ""
"TLS (also known as SSL) is usually only needed when using port 465. For "
"other ports EmailEngine falls back to using STARTTLS based encryption."
msgstr ""
"TLS (znany również jako SSL) jest zwykle potrzebny tylko w przypadku "
"korzystania z portu 465. W przypadku innych portów EmailEngine powraca do "
"szyfrowania opartego na STARTTLS."

#: views/accounts/register/imap-server.hbs:240
msgid "Verify connection"
msgstr "Zweryfikuj połączenie"

#: views/accounts/register/imap-server.hbs:246
msgid "Save and continue"
msgstr "Zapisz i kontynuuj"

#: views/accounts/register/imap-server.hbs:255
msgid "Skip verification"
msgstr "Pomiń weryfikację"

#: views/accounts/register/imap-server.hbs:268
msgid "Connection test failed"
msgstr "Test połączenia nie powiódł się"

#: views/accounts/register/imap-server.hbs:274
msgid "We couldn't connect with these settings. Check the errors below."
msgstr "Nie udało się połączyć z tymi ustawieniami. Sprawdź błędy poniżej."

#: views/accounts/register/imap-server.hbs:407
msgid "Error"
msgstr "Błąd"

#: views/accounts/register/imap-server.hbs:409
msgid "Invalid settings"
msgstr "Nieprawidłowe ustawienia"

#: views/accounts/register/imap-server.hbs:415
msgid "Couldn't connect to IMAP server"
msgstr "Nie udało się połączyć z serwerem IMAP"

#: views/accounts/register/imap-server.hbs:417
#: views/accounts/register/imap-server.hbs:426
msgid "Server response:"
