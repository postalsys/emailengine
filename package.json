{
    "name": "emailengine-app",
    "version": "2.90.0",
    "private": false,
    "productTitle": "EmailEngine",
    "description": "Email Sync Engine",
    "main": "server.js",
    "scripts": {
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "start": "node server.js",
        "dev": "EE_OPENAPI_VERBOSE=true EENGINE_LOG_RAW=true node server --dbs.redis='redis://127.0.0.1:6379/9' --api.port=7003 --api.host=0.0.0.0 | tee $HOME/ee.log.dev.txt  | pino-pretty",
        "single": "EE_OPENAPI_VERBOSE=true EENGINE_LOG_RAW=true EENGINE_SECRET=your-encryption-key EENGINE_WORKERS=1 node --inspect server --dbs.redis='redis://127.0.0.1:6379/6' --api.port=7003 --api.host=0.0.0.0 | tee $HOME/ee.log.single.txt | pino-pretty",
        "gmail": "EE_OPENAPI_VERBOSE=true EENGINE_LOG_RAW=true EENGINE_SECRET=your-encryption-key EENGINE_WORKERS=2 EENGINE_CORS_ORIGIN='*' node --inspect server --dbs.redis='redis://127.0.0.1:6379/11' --api.port=7003 --api.host=0.0.0.0 | tee $HOME/ee.log.gmail.txt | pino-pretty",
        "test": "npm run lint:src && npm run test:unit && npm run test:integration",
        "test:unit": "NODE_ENV=test node test/run-tests.js unit",
        "test:cjs": "NODE_ENV=test NODE_OPTIONS=--no-experimental-require-module node test/run-tests.js unit",
        "test:integration": "NODE_ENV=test node test/run-tests.js integration",
        "test:mutation": "NODE_ENV=test node scripts/mutation-test.js",
        "test:dovecot": "./test/dovecot/run-dovecot-tests.sh",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install --with-deps chromium",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:src": "npx eslint 'lib/**/*.js' 'workers/**/*.js' server.js",
        "swagger": "./getswagger.sh",
        "build:css": "tailwindcss -i static/css/src/app.tailwind.css -o static/css/flyonui.css --minify",
        "build:icon": "node scripts/build-icon.js",
        "build-source": "rm -rf node_modules && npm install && rm -rf node_modules && npm ci --omit=dev --omit=optional && ./prepare-bundle-deps.sh && ./update-info.sh",
        "build-dist": "pkg --compress Brotli package.json && npm install && node winconf.js",
        "build-dist-fast": "pkg --debug package.json && npm install && node winconf.js",
        "licenses": "node list-generate.js",
        "gettext": "find ./views -name \"*.hbs\" -print0 | xargs -0 xgettext-template -L Handlebars --force-po -o - > translations/messages.pot.tmp && node gettext-extract.js",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install && ./copy-static-files.sh && npm run licenses && npm run gettext",
        "test-gmail-api": "node lib/email-client/gmail-client.js --dbs.redis=redis://127.0.0.1/11",
        "format": "prettier --write 'lib/**/*.js' 'workers/**/*.js' 'test/**/*.js' '*.js'",
        "format:check": "prettier --check 'lib/**/*.js' 'workers/**/*.js' 'test/**/*.js' '*.js'"
    },
    "keywords": [
        "IMAP",
        "SMTP",
        "MIME"
    ],
    "author": "Postal Systems OU",
    "license": "LICENSE_EMAILENGINE",
    "bin": {
        "emailengine": "bin/emailengine.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/emailengine.git"
    },
    "bugs": {
        "url": "https://emailengine.app/support",
        "email": "support@postalsys.com"
    },
    "homepage": "https://emailengine.app/",
    "dependencies": {
        "@hapi/accept": "6.0.3",
        "@hapi/bell": "13.2.1",
        "@hapi/boom": "10.0.1",
        "@hapi/cookie": "12.0.1",
        "@hapi/crumb": "9.0.1",
        "@hapi/hapi": "21.4.13",
        "@hapi/inert": "7.1.3",
        "@hapi/vision": "7.0.3",
        "@msgpack/msgpack": "3.1.3",
        "@postalsys/bounce-classifier": "3.1.0",
        "@postalsys/certs": "3.0.1",
        "@postalsys/email-ai-tools": "3.0.3",
        "@postalsys/email-content": "0.1.22",
        "@postalsys/email-text-tools": "3.1.1",
        "@postalsys/gettext": "4.3.2",
        "@postalsys/joi-messages": "1.4.1",
        "@postalsys/templates": "3.0.0",
        "@prometheus-io/client": "0.16.1",
        "@sentry/core": "11.17.0",
        "@simplewebauthn/server": "14.1.0",
        "@zone-eu/mailsplit": "5.4.31",
        "@zone-eu/wild-config": "1.7.10",
        "bullmq": "6.7.10",
        "fast-xml-parser": "5.12.1",
        "handlebars": "4.7.10",
        "he": "1.2.0",
        "html-to-text": "10.0.1",
        "ical.js": "2.2.1",
        "iconv-lite": "0.7.3",
        "imapflow": "2.12.2",
        "ioredfour": "2.2.0",
        "ioredis": "6.1.0",
        "ipaddr.js": "2.5.0",
        "joi": "18.3.2",
        "libbase64": "1.4.1",
        "libmime": "5.6.5",
        "libqp": "3.0.2",
        "mailparser": "3.15.0",
        "marked": "15.0.12",
        "minimist": "1.2.8",
        "nodemailer": "10.6.1",
        "pino": "10.3.1",
        "pubface": "1.2.0",
        "punycode.js": "2.3.1",
        "qrcode-generator": "2.0.4",
        "smtp-server": "3.21.7",
        "socks": "2.8.11",
        "tldts": "7.5.5",
        "undici": "8.13.1"
    },
    "overrides": {
        "@hapi/bell": {
            "joi": "$joi"
        }
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@iconify-json/tabler": "1.2.47",
        "@iconify/tailwind4": "1.2.3",
        "@playwright/test": "1.63.0",
        "@postalsys/ee-client": "2.0.1",
        "@simplewebauthn/browser": "14.0.0",
        "@tailwindcss/cli": "4.3.5",
        "ace-builds": "1.45.2",
        "acorn": "8.19.0",
        "acorn-walk": "8.3.5",
        "eerawlog": "1.5.5",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "flyonui": "2.4.1",
        "gettext-parser": "7.0.1",
        "globals": "17.14.0",
        "pino-pretty": "13.2.0",
        "prettier": "3.10.1",
        "resedit": "3.1.1",
        "spdx-satisfies": "6.0.1",
        "supertest": "7.3.2",
        "tailwindcss": "4.3.5",
        "xgettext-template": "7.0.0"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "pkg": {
        "scripts": [
            "workers/**/*.js"
        ],
        "assets": [
            "static/**/*",
            "views/**/*",
            "lib/lua/**/*",
            "translations/**/*",
            "node_modules/@postalsys/joi-messages/translations/*",
            "node_modules/@postalsys/bounce-classifier/model/**/*",
            "node_modules/@postalsys/email-content/dist/detect/patterns/*.json",
            "LICENSE_EMAILENGINE.txt",
            "version-info.json",
            "sbom.json"
        ],
        "targets": [
            "node24-linux-x64",
            "node24-macos-x64",
            "node24-macos-arm64",
            "node24-win-x64"
        ],
        "outputPath": "ee-dist",
        "options": [
            "max_old_space_size=4096",
            "max_semi_space_size=16"
        ]
    }
}
