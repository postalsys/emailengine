{{> tokens_header}}

{{!-- the account level renders only for account-scoped tokens (ui/breadcrumb skips empty levels) --}}
{{> ui/breadcrumb parentHref="/admin/tokens" parentLabel="Access Tokens" midHref=(when account accountTokensLink) midLabel=account.name current="New" class="mt-6 mb-6"}}

{{!-- A token is never invalidated once minted, so one handed to a caller that reached this page
     without authenticating would keep working - POST /admin/tokens/new refuses for that reason. The
     form used to render anyway, so the only way to discover it was to fill it in and lose the work to
     a 403. Same condition as the gate, so the two cannot disagree. --}}
{{#unless canProvision}}
{{#> ui/stat-card variant="error" title="Set an admin password first" icon="icon-[tabler--shield-lock]" class="mb-6"}}

<p class="mb-4">Access tokens do not expire on their own, so EmailEngine only issues one to a request
    that carries an admin session. This instance has no admin password set, so there is no session to
    carry - set one and the form appears here.</p>
<div>
    {{> ui/btn href="/admin/account/password" variant="primary" icon="icon-[tabler--arrow-right]" label="Enable authentication"}}
</div>

{{/ui/stat-card}}
{{else}}
<form method="post" id="token-form" action="/admin/tokens/new">
    <input type="hidden" name="crumb" value="{{crumb}}" />

    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-body space-y-4">

            {{> ui/form-field id="description" label="Description" value=values.description error=errors.description required=true hint="This description is shown when listing active tokens."}}

            {{!-- Free text rather than a select: an instance can hold far more accounts than a list
                  could usefully carry. The ID is resolved on submit, so a typo is refused rather than
                  minting a token bound to nothing. --}}
            {{> ui/form-field id="account" label="Account ID (optional)" value=values.account error=errors.account placeholder="Leave empty to allow all accounts" hint="A bound token only works for that one account. Requests made for any other account are refused."}}

            <div>
                <h6 class="mb-1 font-bold">Allowed scopes</h6>
                <p class="text-base-content/60 text-sm mb-3">
                    Which surfaces this credential opens. Scopes are fixed the moment the token exists, so
                    a surface left out here cannot be added later.
                </p>

                {{!-- One line of plain words per row. The bracketed slug beside each was the only
                      description a reader got, and a slug is an identifier rather than an
                      explanation - "MCP" in particular says nothing about what the token would then
                      be able to reach, or that it is not REST API access. --}}
                <ul class="divide-y divide-base-content/10 rounded-box border border-base-content/10">
                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm or-else-all scope-entry"
                                data-target="scope-list" id="scopesAll" data-scope="*" name="scopesAll" {{#if
                                values.scopesAll}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesAll">All scopes</label>
                            <div class="text-base-content/60 code-link">["*"]</div>
                        </div>
                        <p class="helper-text ms-7">Every surface below, including any added in a later release.</p>
                    </li>

                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm scope-entry scope-list" id="scopesAPI"
                                name="scopesAPI" data-scope="api" {{#if values.scopesAPI}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesAPI">API</label>
                            <div class="text-base-content/60 code-link">["api"]</div>
                        </div>
                        <p class="helper-text ms-7">The REST API under <code>/v1</code>.</p>
                    </li>

                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm scope-entry scope-list" id="scopesSMTP"
                                name="scopesSMTP" data-scope="smtp" {{#if values.scopesSMTP}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesSMTP">SMTP</label>
                            <div class="text-base-content/60 code-link">["smtp"]</div>
                        </div>
                        <p class="helper-text ms-7">Submit mail through EmailEngine's own SMTP server.</p>
                    </li>

                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm scope-entry scope-list" id="scopesImapProxy"
                                name="scopesImapProxy" data-scope="imap-proxy" {{#if values.scopesImapProxy}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesImapProxy">IMAP Proxy</label>
                            <div class="text-base-content/60 code-link">["imap-proxy"]</div>
                        </div>
                        <p class="helper-text ms-7">Open connected mailboxes with an ordinary IMAP client.</p>
                    </li>

                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm scope-entry scope-list" id="scopesMetrics"
                                name="scopesMetrics" data-scope="metrics" {{#if values.scopesMetrics}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesMetrics">Metrics</label>
                            <div class="text-base-content/60 code-link">["metrics"]</div>
                        </div>
                        <p class="helper-text ms-7">Read the Prometheus metrics endpoint and nothing else.</p>
                    </li>

                    <li class="p-4">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm scope-entry scope-list" id="scopesMcp"
                                name="scopesMcp" data-scope="mcp" {{#if values.scopesMcp}}checked{{/if}} />
                            <label class="label-text grow p-0" for="scopesMcp">MCP
                                {{> ui/badge label="Beta" variant="info" soft=true class="badge-sm align-middle" icon="" elId=""}}</label>
                            <div class="text-base-content/60 code-link">["mcp"]</div>
                        </div>
                        <p class="helper-text ms-7">Let an AI agent call MCP tools at <code>/mcp</code>. This is not REST
                            API access - the same token is refused by <code>/v1</code>.</p>
                        {{!-- The endpoint is off by default, so an operator can otherwise mint a
                              credential for something that is not serving and only find out in the
                              client. Both halves of the gate are folded into mcpReady. Revealed by
                              ticking the box rather than standing on the page: MCP being off is not
                              news to someone provisioning a plain API token, and the default
                              selection ("All scopes") technically carries the mcp scope too. --}}
                        {{#unless mcpReady}}
                        <p id="mcpDisabledHint" class="helper-text ms-7 text-warning hidden">The MCP endpoint is not
                            enabled on this instance, so this token would have nothing to talk to. <a
                                href="/admin/config/mcp" class="link">Turn it on</a> first.</p>
                        {{/unless}}
                    </li>
                </ul>
            </div>

        </div>
    </div>

    {{!-- Its own card rather than a row nested under "API", which is where this used to live. Both
          per-request surfaces carry a narrowing - the REST API resolves it per endpoint, the MCP
          endpoint per tool call - so an editor anchored to the API checkbox opened underneath an
          unticked box whenever MCP alone was selected, titled for a surface the token would not even
          have. What ties it to the scopes now is #accessAppliesTo, which names the ticked scopes it
          affects; that is stricter than an indent, which could only ever point at one of them.

          The record itself stays single: one `permissions` object narrows whatever surface the
          request arrives on. That is why this is one editor with two modes rather than a tab per
          scope - separate panes would promise two records that cannot exist. --}}
    <div id="accessCard" class="hidden" data-surfaces="{{permissionSurfacesJson}}" data-mcp-presets="{{json mcpAccessPresets}}">
        {{#> ui/card bodyClass="space-y-4"}}

        <div>
            <h6 id="accessCardTitle" class="mb-1 font-bold">Access level</h6>
            <p id="accessAppliesTo" class="text-base-content/60 text-sm"></p>
        </div>

        {{!-- MCP-only mode. The three levels are the ones the OAuth consent prompt and the MCP config
              page already offer, from the same table through the same partial, because the same
              credential minted from three places must not mean three different things. A 52-cell
              matrix is not how anyone provisions an agent, so it is the fourth option rather than
              the only one - and unlike the API editor there is no "restrict?" toggle: read-only is
              the default, because an agent credential that starts unrestricted is the wrong way
              round. --}}
        {{!-- Labelled by the card heading rather than carrying a legend of its own, which would
              repeat "Access level" directly under itself --}}
        <fieldset id="mcpLevelBlock" class="hidden space-y-2" aria-labelledby="accessCardTitle">
            {{> mcp_access_levels name="mcpAccess" idPrefix="mcpAccess_" selected="read"}}
            {{> ui/radio id="mcpAccess_custom" name="mcpAccess" value="custom" label="Custom permissions"
                hint="Choose the exact actions and sections yourself, starting from the level selected above."}}

            {{!-- At the decision point, as on the MCP config page: the level chosen here is what
                  decides whether instructions hidden inside received mail can act --}}
            <p class="text-base-content/60 text-sm">Email content flows into whatever model the connected client runs,
                and instructions inside received mail can steer it - grant sending and deleting rights deliberately.</p>
        </fieldset>

        {{!-- API mode. Unrestricted by default, because an API token is the general-purpose
              credential and narrowing it is the exception. --}}
        <div id="apiLimitBlock" class="hidden">
            <p class="text-base-content/60 text-sm mb-3">
                By default this token can use the whole API. Restrict it to hand out a credential for a
                single job: an agent that reads mail but cannot delete it, or a service that can only send.
            </p>
            {{> ui/checkbox id="permissionsEnabled" label="Restrict what this token can do" checked=values.permissionsEnabled error=errors.permissions noName=true}}
        </div>

        {{!-- The whole point of the two axes is what they produce together, and a reader should not
              have to multiply four boxes by thirteen to find out. Saying what the token CANNOT do
              matters as much: that is the reassurance someone wants when handing out a restricted
              credential. Outside #permissionSection because the MCP levels need it too - picking
              "Mail agent" should say what that is, not only reveal a matrix. --}}
        <div id="permissionOutcome" class="rounded-box border border-base-content/10 bg-base-200/40 p-4 text-sm space-y-1 hidden">
            <div id="permissionOutcomeText" class="space-y-1"></div>
            {{!-- Its own element rather than more appended lines: the count is the same one the
                  MCP config generator and the consent prompt show, and it is painted by the
                  shared helper that owns the rule. --}}
            {{> mcp_tool_count id="mcpToolCount" class="pt-1"}}
        </div>

        {{!-- Filled in by the script below whenever a scope or an axis changes. Holding a scope the
              permissions make unusable is legitimate, so this warns rather than refuses - but it
              should never be a surprise. What each surface requires is handed over as data, derived
              from the tables that enforce it, so this cannot describe rules that have since
              changed. --}}
        <div id="permissionScopeWarning" class="alert alert-soft alert-warning text-sm hidden"></div>

        <div id="permissionSection" class="space-y-5 hidden">

            <div id="permissionPresetRow">
                <h6 class="mb-1 font-bold">Pick a preset</h6>
                <p class="text-base-content/60 text-sm mb-2">
                    These cover the usual shapes. Adjust the details below if you need something else.
                </p>
                <div class="flex flex-wrap gap-2">
                    {{#each permissionPresets}}
                    <button type="button" class="btn btn-sm btn-soft permission-preset" data-actions="{{actionList}}"
                        data-groups="{{groupList}}" title="{{title}}">{{label}}</button>
                    {{/each}}
                </div>
            </div>

            <div>
                <h6 class="mb-2 font-bold">What it can do</h6>
                <ul class="divide-y divide-base-content/10 rounded-box border border-base-content/10">
                    {{#each permissionActions}}
                    <li class="flex items-center gap-2 p-4" data-axis-row="action:{{value}}">
                        {{> ui/checkbox id=inputId label=label checked=checked noName=true dataValue=value class="permission-axis permission-action"}}
                        <div class="text-base-content/60 code-link ms-auto self-start">["{{value}}"]</div>
                    </li>
                    {{/each}}
                </ul>
            </div>

            <div>
                <h6 class="mb-2 font-bold">What it can reach</h6>
                <div class="space-y-3">
                    {{#each permissionGroupClusters}}
                    <div data-cluster="{{label}}">
                        <div class="text-base-content/60 text-xs uppercase tracking-wide mb-1">{{label}}</div>
                        <ul class="divide-y divide-base-content/10 rounded-box border border-base-content/10">
                            {{#each groups}}
                            <li class="flex items-center gap-2 p-4" data-axis-row="group:{{value}}">
                                {{> ui/checkbox id=inputId label=label checked=checked hint=description noName=true dataValue=value class="permission-axis permission-group"}}
                                <div class="text-base-content/60 code-link ms-auto self-start">["{{value}}"]</div>
                            </li>
                            {{/each}}
                        </ul>
                    </div>
                    {{/each}}
                </div>

                {{!-- Only rendered in MCP-only mode, where two thirds of the sections above would be
                      inert: ticking "Webhook routes" for a token that can only reach /mcp changes
                      nothing at all, so those rows are taken out rather than left as decisions with
                      no effect. --}}
                <div id="permissionMcpScopeNote" class="mt-3 text-base-content/60 text-sm hidden">Only the sections the
                    MCP endpoint can reach are listed. The rest exist on the REST API, which a token scoped to MCP
                    cannot call at all.</div>

                {{!-- Rendered as a visibly refused option rather than omitted: leaving it out
                      entirely reads as an oversight, and the reason is the point. --}}
                <div class="mt-3 alert alert-soft alert-warning text-sm">
                    <span class="icon-[tabler--lock] size-5 shrink-0"></span>
                    <span>
                        Some endpoints are never available to a restricted token, whatever you select here:
                        settings, OAuth2 applications, licensing, access tokens and stored account
                        credentials. A token that could reach those could grant itself more.
                    </span>
                </div>
            </div>
        </div>

        {{/ui/card}}
    </div>

    <div class="mb-6">
        {{> ui/btn label="Generate a token" type="submit" icon="icon-[tabler--key]"}}
    </div>
</form>

{{!-- Wider than the default: the token is 64 characters and this is the only time it is shown, so
      it has to be readable in full rather than scrolled through a 32-character window. --}}
{{#> ui/modal id="showToken" title="Access tokens" static=true dialogClass="max-w-2xl"}}
<div class="modal-body">
    <div id="showTokenLoader" class="py-2 text-center">
        <span class="loading loading-spinner loading-sm align-middle"></span> Generating token&hellip;
    </div>
    <div id="showTokenContent" class="hidden">

        <div class="mb-2">Access token:</div>
        {{!-- w-full because ui/copy-field's join wrapper is inline-flex, so the `grow` on the input
              has nothing to grow inside and the field kept its intrinsic width. text-sm so all 64
              characters fit: this is the only time the value is ever shown, and a token truncated at
              32 characters cannot be checked against what was copied. --}}
        {{> ui/copy-field id="showTokenValue" ariaLabel="Access token" join=true class="w-full" inputClass="font-mono text-sm bg-base-200 border-0 autoselect"}}

    </div>
    <div id="showTokenError" class="hidden alert alert-soft alert-error whitespace-pre-line"></div>
</div>
<div class="modal-footer">
    {{> ui/btn label="Done" variant="neutral" style="soft" overlay="#showToken"}}
</div>
{{/ui/modal}}

<script>
    document.addEventListener('DOMContentLoaded', () => {

        let showTokenValueElm = document.getElementById('showTokenValue');

        // Read by the tool count as well as by the submit handler: binding a token to an account
        // changes which MCP tools it is offered, so the field is an input to the editor and not
        // only a payload field.
        let accountElm = document.getElementById('account');

        let accessCardElm = document.getElementById('accessCard');
        let accessAppliesToElm = document.getElementById('accessAppliesTo');
        let mcpLevelBlockElm = document.getElementById('mcpLevelBlock');
        let apiLimitBlockElm = document.getElementById('apiLimitBlock');
        let permissionsEnabledElm = document.getElementById('permissionsEnabled');
        let permissionSectionElm = document.getElementById('permissionSection');
        let permissionPresetRowElm = document.getElementById('permissionPresetRow');
        let permissionOutcomeElm = document.getElementById('permissionOutcome');
        let permissionOutcomeTextElm = document.getElementById('permissionOutcomeText');
        let mcpToolCountElm = document.getElementById('mcpToolCount');
        let permissionWarningElm = document.getElementById('permissionScopeWarning');
        let permissionMcpNoteElm = document.getElementById('permissionMcpScopeNote');

        // Everything this editor reasons about is handed over as data on one element: what each
        // surface requires, what each MCP tool dispatches under, and what each named access level
        // mints. All three are derived server-side from the tables that enforce them rather than
        // restated here, so a change to the rules cannot leave the page describing the old ones.
        let surfaceRequirements = {};
        for (let entry of JSON.parse(accessCardElm.dataset.surfaces || '[]')) {
            surfaceRequirements[entry.scope] = {
                label: entry.label,
                // 'all': checked once at login, every grant required. 'any': checked per
                // request, usable while a single grant pair stays allowed.
                mode: entry.mode,
                actions: entry.actionList.split(',').filter(value => value),
                groups: entry.groupList.split(',').filter(value => value),
                grants: entry.grantList.split(',').filter(value => value).map(pair => pair.split(':'))
            };
        }

        let mcpAccessPresets = JSON.parse(accessCardElm.dataset.mcpPresets || '{}');
        // What the mcp scope can reach at all, which is also what the "Full access" level means:
        // that level stores no record, so the surface grant list is its own description.
        let mcpCeiling = surfaceRequirements.mcp || { actions: [], groups: [], grants: [] };

        let scopeElms = Array.from(document.querySelectorAll('.scope-entry'));
        let selectedScopes = () => scopeElms.filter(elm => elm.checked && !elm.disabled).map(elm => elm.dataset.scope);

        // Permissions are resolved per endpoint on the REST API and per tool call on the MCP
        // endpoint, so both of those scopes can carry a narrowing. The login-time scopes (SMTP,
        // IMAP proxy, Metrics) are checked once against everything their surface can do, so for
        // them any restriction either changes nothing or leaves the token unable to do the one
        // thing it was issued for. Scopes are fixed once the token exists, so the card is absent
        // rather than disabled when no per-request scope is ticked.
        //
        // "All scopes" only disables the individual boxes, it does not tick them, so the API row can
        // be greyed while this is open. That reads correctly: API access is granted by "All", and
        // this is how to narrow it.
        let hasApiScope = () => selectedScopes().some(scope => ['*', 'api'].includes(scope));
        let hasMcpScope = () => selectedScopes().some(scope => ['*', 'mcp'].includes(scope));
        let narrowableScope = () => hasApiScope() || hasMcpScope();

        // The two editor modes. A token that reaches the MCP endpoint and not the REST API is a
        // different thing from an API token - it is an agent connector, provisioned by picking a
        // named level, the way the OAuth consent prompt and the MCP config page already do it. Any
        // selection that includes API access falls back to the matrix instead, because one
        // permissions record covers both surfaces and the API side needs all thirteen sections.
        let mcpLevelMode = () => hasMcpScope() && !hasApiScope();

        let selectedMcpLevel = () => {
            let elm = document.querySelector('input[name="mcpAccess"]:checked');
            return (elm && elm.value) || 'read';
        };

        // Sections the MCP surface can never reach are disabled while the level editor is showing,
        // so every read of the axes skips them. Ticking "Webhook routes" for a token that can only
        // call MCP tools grants nothing, and a control with no effect is worse than an absent one.
        let axisElms = selector => Array.from(document.querySelectorAll(selector)).filter(elm => !elm.disabled);
        let tickedValues = selector => axisElms(selector).filter(elm => elm.checked).map(elm => elm.dataset.value);

        let labelFor = elm => document.querySelector('label[for="' + elm.id + '"]').textContent.trim();

        // Slug to label, read off the rendered rows so the sentence below cannot name an axis by a
        // second, hand-written label. Built once: it does not depend on what is ticked.
        let axisLabels = { action: {}, group: {} };
        for (let elm of document.querySelectorAll('.permission-axis')) {
            axisLabels[elm.classList.contains('permission-action') ? 'action' : 'group'][elm.dataset.value] = labelFor(elm);
        }
        let allActions = Object.keys(axisLabels.action);
        let labelsFor = (axis, values) => values.map(value => axisLabels[axis][value] || value);

        let asList = values => (values.length > 1 ? values.slice(0, -1).join(', ') + ' and ' + values[values.length - 1] : values[0] || '');

        // The one record the whole page reads: the outcome sentence, the scope warning, the tool
        // count and the submit payload all resolve it rather than each reading the DOM their own
        // way. A named MCP level answers from the access table itself, not from the axes it would
        // tick, so a level mints here exactly what it mints on the consent prompt.
        //
        // `unrestricted` is the absence of a permissions record, which is a different answer from
        // an empty one: it means the scopes are the only bound.
        let effectiveRecord = () => {
            if (mcpLevelMode()) {
                let level = selectedMcpLevel();
                if (level !== 'custom') {
                    let record = mcpAccessPresets[level];
                    if (record) {
                        return { actions: record.actions, groups: record.groups, unrestricted: false };
                    }
                    // The full level is the one that legitimately stores no record. Any other level
                    // missing from the table means the table did not load, and a missing preset must
                    // not quietly mint a wider credential than the level on screen promises - the
                    // MCP config page's generator refuses the same way, and the consent route
                    // defaults the same direction.
                    return {
                        actions: mcpCeiling.actions,
                        groups: mcpCeiling.groups,
                        unrestricted: true,
                        unknownLevel: !Object.prototype.hasOwnProperty.call(mcpAccessPresets, level)
                    };
                }
            } else if (!permissionsEnabledElm.checked) {
                return { actions: allActions, groups: Object.keys(axisLabels.group), unrestricted: true };
            }

            return { actions: tickedValues('.permission-action'), groups: tickedValues('.permission-group'), unrestricted: false };
        };

        // Applies a permission record to the axes. Shared by the API presets and by the switch into
        // "Custom permissions", so the boxes a preset shows are the boxes that preset mints.
        let applyRecord = (actions, groups) => {
            for (let elm of document.querySelectorAll('.permission-action')) {
                elm.checked = actions.includes(elm.dataset.value);
            }
            for (let elm of document.querySelectorAll('.permission-group')) {
                elm.checked = groups.includes(elm.dataset.value);
            }
        };

        let syncAxisAvailability = () => {
            let restrictToMcp = mcpLevelMode();

            for (let elm of document.querySelectorAll('.permission-axis')) {
                let axis = elm.classList.contains('permission-action') ? 'actions' : 'groups';
                let reachable = !restrictToMcp || mcpCeiling[axis].includes(elm.dataset.value);

                // Disabled rather than unticked: flipping the scopes back has to restore the
                // selection rather than quietly lose it, and a disabled box is skipped by every
                // read, so an out-of-reach section cannot ride into the posted record.
                elm.disabled = !reachable;
                let row = elm.closest('[data-axis-row]');
                if (row) {
                    row.classList.toggle('hidden', !reachable);
                }
            }

            // A cluster whose every section is out of reach is a heading over nothing
            for (let cluster of document.querySelectorAll('[data-cluster]')) {
                let visible = Array.from(cluster.querySelectorAll('[data-axis-row]')).some(row => !row.classList.contains('hidden'));
                cluster.classList.toggle('hidden', !visible);
            }

            permissionMcpNoteElm.classList.toggle('hidden', !restrictToMcp);
        };

        // What the current selection produces, in words. Without it a reader has to cross four boxes
        // with thirteen to work out what they just built - and the half that reassures, what the
        // token CANNOT do, is not visible anywhere at all.
        let syncPermissionOutcome = () => {
            let visible = narrowableScope() && (mcpLevelMode() || permissionsEnabledElm.checked);

            permissionOutcomeTextElm.replaceChildren();
            permissionOutcomeElm.classList.toggle('hidden', !visible);
            if (!visible) {
                window.uiMcpToolCount(mcpToolCountElm, null);
                return;
            }

            let record = effectiveRecord();

            // The same count the MCP config generator and the consent prompt show, painted by the
            // shared helper rather than restated here - it owns both filters, the permission record
            // and the account binding. Null when the token does not carry the surface at all, so a
            // stale count cannot survive a scope change.
            window.uiMcpToolCount(mcpToolCountElm, hasMcpScope() ? Object.assign({ account: accountElm.value }, record) : null);

            if (!record.unrestricted && (!record.actions.length || !record.groups.length)) {
                let line = document.createElement('div');
                line.className = 'text-warning';
                line.textContent = 'Nothing is selected yet, so this token would not be able to do anything.';
                permissionOutcomeTextElm.append(line);
                return;
            }

            let can = document.createElement('div');
            let canLabel = document.createElement('strong');
            canLabel.textContent = 'This token can ';
            can.append(
                canLabel,
                document.createTextNode(asList(labelsFor('action', record.actions)).toLowerCase() + ' in ' + asList(labelsFor('group', record.groups)) + '.')
            );
            permissionOutcomeTextElm.append(can);

            let deniedActions = allActions.filter(value => !record.actions.includes(value));
            if (deniedActions.length) {
                let cannot = document.createElement('div');
                cannot.className = 'text-base-content/60';
                cannot.textContent = 'It cannot ' + asList(labelsFor('action', deniedActions)).toLowerCase() + ', anywhere.';
                permissionOutcomeTextElm.append(cannot);
            }

            let rest = document.createElement('div');
            rest.className = 'text-base-content/60';
            rest.textContent = 'It cannot reach anything else, or read credentials and settings.';
            permissionOutcomeTextElm.append(rest);
        };

        let syncPermissionWarning = () => {
            let record = effectiveRecord();

            if (record.unrestricted || !narrowableScope()) {
                permissionWarningElm.classList.add('hidden');
                return;
            }

            let scopes = selectedScopes();

            // "All scopes" carries every surface with it
            if (scopes.includes('*')) {
                scopes = Object.keys(surfaceRequirements);
            }

            let blocked = scopes
                .filter(scope => surfaceRequirements[scope])
                .filter(scope => {
                    let need = surfaceRequirements[scope];
                    if (need.mode === 'any') {
                        // Per-request surface: usable while any one (action, group) pair survives
                        return !need.grants.some(([action, group]) => record.actions.includes(action) && record.groups.includes(group));
                    }
                    return !need.actions.every(value => record.actions.includes(value)) || !need.groups.every(value => record.groups.includes(value));
                })
                .map(scope => surfaceRequirements[scope].label);

            if (!blocked.length) {
                permissionWarningElm.classList.add('hidden');
                return;
            }

            permissionWarningElm.textContent =
                'These permissions stop the token doing something its scopes allow: it will not be able to ' +
                blocked.join(', or ') +
                '. Untick that scope, or allow what it needs.';
            permissionWarningElm.classList.remove('hidden');
        };

        // Names the scopes this editor actually affects. The old nesting asserted that relationship
        // with an indent under the API checkbox, which stopped being true the moment a second scope
        // carried a narrowing - and read as a lie whenever that checkbox was unticked.
        let syncAccessHeader = () => {
            let surfaces = [];
            if (hasApiScope()) {
                surfaces.push('REST API requests');
            }
            if (hasMcpScope()) {
                surfaces.push('MCP tool calls');
            }

            accessAppliesToElm.textContent =
                surfaces.length > 1
                    ? 'Applies to ' + surfaces.join(' and ') + '. One set of limits covers both surfaces.'
                    : 'Applies to ' + surfaces[0] + '.';
        };

        let syncAccessCard = () => {
            let visible = narrowableScope();

            accessCardElm.classList.toggle('hidden', !visible);
            if (!visible) {
                return;
            }

            let levelMode = mcpLevelMode();

            syncAccessHeader();
            mcpLevelBlockElm.classList.toggle('hidden', !levelMode);
            apiLimitBlockElm.classList.toggle('hidden', levelMode);
            syncAxisAvailability();

            // The matrix is the detail view behind either mode: the "Custom permissions" level on
            // one side, the restriction toggle on the other. The API presets are shapes for the
            // REST API, so they stay out of the way in level mode, where the named levels above
            // are the presets.
            permissionSectionElm.classList.toggle('hidden', levelMode ? selectedMcpLevel() !== 'custom' : !permissionsEnabledElm.checked);
            permissionPresetRowElm.classList.toggle('hidden', levelMode);
        };

        // Only rendered when the endpoint is off, and only shown once the box that needs it is
        // ticked - the default selection carries the mcp scope with everything else, and warning
        // about a disabled endpoint on a page nobody opened for MCP is noise.
        let mcpDisabledHintElm = document.getElementById('mcpDisabledHint');
        let scopesMcpElm = document.getElementById('scopesMcp');

        let syncAll = () => {
            syncAccessCard();
            syncPermissionWarning();
            syncPermissionOutcome();

            if (mcpDisabledHintElm) {
                mcpDisabledHintElm.classList.toggle('hidden', !scopesMcpElm.checked || scopesMcpElm.disabled);
            }
        };

        permissionsEnabledElm.addEventListener('change', () => {
            // Enabling with nothing ticked would post two empty allowlists, which grant nothing. Start
            // from everything selected so the first state is "no narrowing yet" and each untick is a
            // deliberate subtraction.
            if (permissionsEnabledElm.checked && !document.querySelector('.permission-axis:checked')) {
                for (let elm of document.querySelectorAll('.permission-axis')) {
                    elm.checked = true;
                }
            }
            syncAll();
        });

        // The level the axes are seeded from when "Custom permissions" is picked, which is what its
        // hint promises. Starts at the default selection rather than empty.
        let lastNamedLevel = selectedMcpLevel();
        for (let elm of document.querySelectorAll('input[name="mcpAccess"]')) {
            elm.addEventListener('change', () => {
                if (elm.value === 'custom') {
                    let record = mcpAccessPresets[lastNamedLevel];
                    applyRecord(record ? record.actions : mcpCeiling.actions, record ? record.groups : mcpCeiling.groups);
                } else {
                    lastNamedLevel = elm.value;
                }
                syncAll();
            });
        }

        for (let elm of document.querySelectorAll('.permission-axis, .scope-entry')) {
            elm.addEventListener('change', syncAll);
        }

        // Per keystroke, because what the binding costs an agent should be visible while the field
        // is being filled in rather than only after it loses focus
        accountElm.addEventListener('input', syncAll);

        for (let button of document.querySelectorAll('.permission-preset')) {
            button.addEventListener('click', () => {
                applyRecord((button.dataset.actions || '').split(',').filter(value => value), (button.dataset.groups || '').split(',').filter(value => value));
                syncAll();
            });
        }

        syncAll();

        document.getElementById('token-form').addEventListener('submit', e => {
            e.preventDefault()

            let description = document.getElementById('description').value.trim();
            document.getElementById('description').value = description

            // Trimmed so the redirect below filters the listing on the same value that was posted
            let account = accountElm.value.trim();
            accountElm.value = account

            let scopes = [];
            for (let elm of scopeElms) {
                if (elm.checked && !elm.disabled) {
                    scopes.push(elm.dataset.scope);
                }
            }

            if (scopes.includes('*')) {
                scopes = ['*'];
            }

            let wasShown = false;

            document.getElementById('showToken').addEventListener('close.overlay', () => {
                document.getElementById('showTokenLoader').classList.remove('hidden');
                document.getElementById('showTokenContent').classList.add('hidden');
                document.getElementById('showTokenError').classList.add('hidden');
                showTokenValueElm.value = '';

                if (wasShown) {
                    location.assign("/admin/tokens" + (account ? '?account=' + encodeURIComponent(account) : ''));
                }
            }, { once: true });

            document.getElementById('showTokenLoader').classList.remove('hidden');
            document.getElementById('showTokenContent').classList.add('hidden');
            document.getElementById('showTokenError').classList.add('hidden');
            uiModal.open('#showToken');

            // Omitting the field is what "not narrowed" means on the record, so an unchecked toggle -
            // and the MCP "Full access" level, which the access table stores as null for exactly that
            // reason - must not post an empty object. That is a different answer, and the API refuses
            // it.
            let record = effectiveRecord();
            let permissions = record.unrestricted ? null : { actions: record.actions, groups: record.groups };

            let refuse = message => {
                document.getElementById('showTokenLoader').classList.add('hidden');
                document.getElementById('showTokenContent').classList.add('hidden');
                document.getElementById('showTokenError').classList.remove('hidden');
                document.getElementById('showTokenError').textContent = message;
                uiModal.open('#showToken');
            };

            // The access table failed to load, so the level on screen cannot be resolved to the
            // record it promises. Refused rather than posted: what would go out is the absence of a
            // narrowing, which is the widest answer there is.
            if (record.unknownLevel) {
                refuse('The access levels failed to load, so the selected level cannot be applied. Reload the page and try again.');
                return;
            }

            // Said here rather than left to the schema. tokenPermissionsSchema refuses an empty axis
            // too, but a joi rejection reaches this page as a bare "HTTP error! status: 400", which
            // tells the reader nothing about the box they left unticked.
            if (permissions && (!permissions.actions.length || !permissions.groups.length)) {
                let missing = !permissions.actions.length ? 'action' : 'section';
                refuse(`Select at least one ${missing}. A restriction that allows nothing would create a token that cannot make any request.`);
                return;
            }

            uiPostJson('/admin/tokens/new', {
                description,
                scopes,
                permissions,
                account
            }).then(data => {

                if (!data.success) {
                    throw new Error(`${data.error}\n${data.message}`);
                }

                document.getElementById('showTokenLoader').classList.add('hidden');
                document.getElementById('showTokenContent').classList.remove('hidden');
                document.getElementById('showTokenError').classList.add('hidden');
                showTokenValueElm.value = data.token;

                wasShown = true
            }).catch(err => {
                document.getElementById('showTokenLoader').classList.add('hidden');
                document.getElementById('showTokenContent').classList.add('hidden');
                document.getElementById('showTokenError').classList.remove('hidden');

                document.getElementById('showTokenError').textContent = err.message;
            });
        });
    })
</script>
{{/unless}}
