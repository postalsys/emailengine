{{#> ui/page-header title="Access Tokens" icon="icon-[tabler--key]" subtitle="Bearer tokens that authenticate requests to the EmailEngine API." badgeLabel=total badgeVariant="neutral" class="mb-6"}}
{{!-- Without an admin session the create form cannot submit, so the button would be an invitation
     to lose the work. Disabled with the reason rather than hidden: the capability exists, it is the
     instance that is not ready for it. --}}
{{#if canProvision}}
{{> ui/btn href=newLink label="Create access token" icon="icon-[tabler--plus]"}}
{{else}}
{{#> ui/tooltip text="Set an admin password to issue access tokens"}}
{{> ui/btn href="/admin/account/password" variant="primary" style="soft" label="Create access token" icon="icon-[tabler--lock]"}}
{{/ui/tooltip}}
{{/if}}
{{/ui/page-header}}

{{> ui/search-crumb parentHref="/admin/tokens" parentLabel="Access Tokens" query=query}}

{{!-- The scope deep-link filter (the MCP pages link here with ?scope=mcp): named the same way an
     active search is, with the parent crumb as the way out of it --}}
{{#if scopeFilter}}
{{> ui/breadcrumb parentHref="/admin/tokens" parentLabel="Access Tokens" current=(concat 'Tokens with the "' scopeFilter '" scope') class="mb-6"}}
{{/if}}

{{#if data.tokens}}
<div class="card bg-base-100 shadow-md mb-6">
    {{#if account}}
    <div class="card-body">
        <div>
            Currently showing tokens for <strong><a href="/admin/accounts/{{urlpart account.account}}"
                    class="link link-animated">{{account.name}}</a></strong>. These tokens cannot be
            used by other accounts.
        </div>
    </div>
    {{/if}}
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Description</th>
                    {{#if showAccountColumn}}
                    <th>Bound to</th>
                    {{/if}}
                    <th>Scopes</th>
                    <th>Last used</th>
                    <th class="w-12"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>

            <tbody>
                {{#each data.tokens}}
                <tr>
                    <td>
                        <div class="flex flex-wrap items-center gap-2">
                            <strong>{{description}}</strong>
                            {{#if expiresStr}}
                            {{> ui/badge label="Expires" variant="warning" soft=true icon="" class=""}}
                            {{/if}}
                        </div>
                        {{> ui/entity-id id=id short=idShort label="Token ID"}}
                        {{#if expiresStr}}
                        <div class="text-base-content/60 text-xs">Expires <span class="relative-time" data-time="{{expiresStr}}"></span></div>
                        {{/if}}
                    </td>

                    {{#if ../showAccountColumn}}
                    <td class="align-top">
                        {{#if account}}
                        {{#if accountKnown}}
                        <a href="/admin/accounts/{{urlpart account}}" class="link link-animated">{{account}}</a>
                        {{else}}
                        <div>{{account}}</div>
                        {{!-- Deleting an account leaves its tokens behind and they still
                              authenticate, so this is a state to act on, not a rendering accident --}}
                        {{> ui/badge label="Account deleted" variant="warning" soft=true icon="" class="mt-1"}}
                        {{/if}}
                        {{else}}
                        <span class="text-base-content/60">All accounts</span>
                        {{/if}}
                    </td>
                    {{/if}}

                    <td class="align-top">
                        {{#if scopes}}
                        <div class="max-w-xs whitespace-normal">{{#each scopes}}{{#unless first}}, {{/unless}}{{name}}{{/each}}</div>
                        {{/if}}

                        {{#if permissionSummary}}
                        {{#if permissionSummary.unreadable}}
                        {{> ui/badge label="Unreadable restriction" variant="error" soft=true icon="" class="mt-1"}}
                        <div class="text-base-content/60 text-xs">Every request with this token is refused. Delete and reissue it.</div>
                        {{else}}
                        {{> ui/badge label="Restricted" variant="info" soft=true icon="" class="mt-1"}}
                        {{!-- Wraps and is width-capped: a token granted several sections produced one
                              long line that pushed the whole table into horizontal scroll. --}}
                        <div class="text-base-content/60 text-xs max-w-xs whitespace-normal">{{permissionSummary.sentence}}</div>
                        {{/if}}
                        {{/if}}
                    </td>

                    <td>
                        {{#if access.timeStr}}
                        <span class="relative-time" data-time="{{access.timeStr}}"></span>
                        {{else}}
                        <span>Never used</span>
                        {{/if}}
                    </td>

                    <td class="text-end">
                        {{> ui/row-actions label="Token actions" deleteModal="#deleteToken" deleteId=id deleteName=description}}
                    </td>

                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    {{> ui/pagination showPaging=showPaging prevPage=prevPage nextPage=nextPage pageLinks=pageLinks}}
</div>

{{else}}
{{!-- The condition sits OUTSIDE the ui/list-empty block on purpose: a partial block whose
     content is nothing but a {{#if}} wrapper loses its content to a Handlebars
     program-association bug (the account note never rendered). Keep the block's first
     content token a static element. --}}
{{#if account}}
{{#> ui/list-empty noun="access tokens" query=query filterActive=scopeFilter firstPage=firstPage createHref=newLink createLabel="Create your first access token" clearHref="/admin/tokens"}}
<div class="mb-2">
    Currently showing tokens for <strong><a href="/admin/accounts/{{urlpart account.account}}"
            class="link link-animated">{{#if account.name}}{{account.name}}{{else}}{{account.email}}{{/if}}</a></strong>.
    These tokens cannot be used by other accounts.
</div>
{{/ui/list-empty}}
{{else}}
{{> ui/list-empty noun="access tokens" query=query filterActive=scopeFilter firstPage=firstPage createHref=newLink createLabel="Create your first access token" clearHref="/admin/tokens"}}
{{/if}}
{{/if}}


{{#> ui/details summary="Usage instructions" class="card bg-base-100 shadow-md mb-6"}}
<div>
        <p class="mb-4">You must use either the <em>Authorization: Bearer</em> header (recommended) or the
            <em>access_token</em> query parameter to make API requests. Avoid using the query parameter as it is
            not redacted from HTTP logs.
        </p>

        <pre class="ee-code-block">$ curl "<span class="cur-base-url" data-origin="">http://127.0.0.1:3000</span>/v1/stats?access_token=&lt;token&gt;"
$ curl "<span class="cur-base-url" data-origin="">http://127.0.0.1:3000</span>/v1/stats" --header "Authorization: Bearer &lt;token&gt;"</pre>

        <p class="mt-4 mb-4">Prometheus endpoint at <code>/metrics</code> also requires an authorization
            token. Use the following configuration for setting up the token for a scraping endpoint:
        </p>

        <pre class="ee-code-block">authorization:
  type: Bearer
  credentials: &lt;token&gt;</pre>

        <hr class="my-4">
        <div class="text-base-content/60">
            <code>&lt;token&gt;</code> is the full access token string without any quoting.
        </div>
        <div class="text-base-content/60">Read more about setting
            up Prometheus and Grafana with EmailEngine from the <a href="https://learn.emailengine.app/docs/advanced/monitoring#prometheus-metrics"
                target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
                class="link link-animated">documentation</a>.
        </div>

</div>
{{/ui/details}}

{{> ui/delete-modal id="deleteToken" noun="access token" action="/admin/tokens/delete" fieldName="token"}}
