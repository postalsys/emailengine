{{> accounts_header}}

{{> ui/breadcrumb parentHref="/admin/accounts" parentLabel="Accounts" midHref=(concat "/admin/accounts/" (urlpart account)) midLabel=account current="Browse" class="mt-6 mb-6"}}

<div id="email-client"></div>

{{#> ui/modal id="confirmModal" title="Confirm" titleId="confirmModalLabel"}}
<div class="modal-body">
    <p id="confirm-text"></p>
</div>
<div class="modal-footer">
    {{!-- Both buttons dismiss through data-overlay. The OK button used to close the overlay
          from its own handler, which races with HSOverlay's deferred open and close and can
          strand the dialog on screen - see window.uiConfirmModal in static/js/ui.js. --}}
    <button type="button" id="confirm-cancel" class="btn btn-soft btn-neutral" data-overlay="#confirmModal">Close</button>
    <button type="button" id="confirm-ok" class="btn btn-primary" data-overlay="#confirmModal">OK</button>
</div>
{{/ui/modal}}

{{#> ui/modal id="alertModal" title="Notice" titleId="alertModalLabel"}}
<div class="modal-body">
    <p id="alert-text"></p>
</div>
<div class="modal-footer">
    <button type="button" id="alert-ok" class="btn btn-primary" data-overlay="#alertModal">OK</button>
</div>
{{/ui/modal}}

<script type="module" nonce="{{cspNonce}}">
    import { EmailEngineClient } from '/static/js/ee-client.js';

    // Create client with UI container. The embed follows the admin theme -
    // its own dark mode toggle stays hidden and the mode tracks the topbar
    // theme switch (data-theme on the root element) and the system scheme.
    const client = new EmailEngineClient({
        apiUrl: window.location.origin,
        account: '{{account}}',
        accessToken: '{{sessionToken}}',
        // the widget appends its own stylesheet element; the admin policy accepts it with this nonce
        styleNonce: '{{cspNonce}}',
        container: document.getElementById('email-client'),
        darkMode: uiEffectiveTheme() === 'dark',
        showDarkModeToggle: false,
        // Text is this page's to fill; the answer comes from the shared dialog helper
        confirmMethod: (message, title = 'Confirm', cancelText = 'Cancel', okText = 'OK') => {
            document.getElementById('confirm-text').textContent = message;
            document.getElementById('confirmModalLabel').textContent = title;
            document.getElementById('confirm-cancel').textContent = cancelText;
            document.getElementById('confirm-ok').textContent = okText;

            return uiConfirmModal('#confirmModal', '#confirm-ok');
        },

        // An alert has nothing to answer, so callers just await it being dismissed. The
        // resolved value is deliberately passed through rather than forced to true: forcing
        // it would report a dialog that never opened as one the reader acknowledged.
        alertMethod: (message, title = 'Notice', cancelText = null, okText = 'OK') => {
            document.getElementById('alert-text').textContent = message;
            document.getElementById('alertModalLabel').textContent = title;
            document.getElementById('alert-ok').textContent = okText;

            return uiConfirmModal('#alertModal', '#alert-ok');
        }
    });

    // keep the embed in sync: the topbar toggle stamps data-theme on the root
    // element, and with no stored choice the effective theme follows the
    // system scheme
    const syncClientTheme = () => client.setDarkMode(uiEffectiveTheme() === 'dark');
    uiOnThemeChange(syncClientTheme);
</script>
