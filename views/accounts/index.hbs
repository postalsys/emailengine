{{#> ui/page-header title="Accounts" icon="icon-[tabler--users]" subtitle="Connect and manage email accounts for syncing and sending email." badgeLabel=total badgeVariant="neutral" class="mb-6"}}
{{> ui/btn label="Add account" icon="icon-[tabler--user-plus]" overlay="#addAccount"}}
{{/ui/page-header}}

{{> ui/search-crumb parentHref="/admin/accounts" parentLabel="Accounts" query=query}}

{{#if accounts}}
{{> accounts_table showActions=true}}
{{else}}
{{> ui/list-empty noun="accounts" query=query filterActive=state firstPage=firstPage createOverlay="#addAccount" createLabel="Add your first account" clearHref="/admin/accounts"}}
{{/if}}

{{#> ui/delete-modal id="deleteAccount" noun="account" action="/admin/accounts"}}
Delete <strong class="delete-target-name"></strong> from EmailEngine? This removes its synced data, account-specific templates, access tokens, and queued emails. Emails on the mail server are not deleted. This action cannot be undone.
{{/ui/delete-modal}}

