{{> accounts_header}}

{{> ui/breadcrumb parentHref="/admin/accounts" parentLabel="Accounts" midHref=(concat "/admin/accounts/" (urlpart account)) midLabel=account current="Edit" class="mt-6 mb-6"}}

<form method="post" action="/admin/accounts/{{urlpart account}}/edit">
    <input type="hidden" name="crumb" value="{{crumb}}">

    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-header">
            <h6 class="card-title text-primary">Account</h6>
        </div>

        <div class="card-body space-y-4">

            {{> ui/form-field id="name" label="Full name" value=values.name error=errors.name hint="Name shown for this account in EmailEngine."}}
            {{> ui/form-field id="email" type="email" label="Email address" value=values.email error=errors.email hint="Email address associated with this account."}}
            {{> ui/form-field id="expectedEmail" type="email" label="Required email address (optional)" value=values.expectedEmail error=errors.expectedEmail hint="The hosted authentication form only accepts sign-ins that match this address. Leave blank to remove this restriction."}}

        </div>
    </div>

    {{#unless isApi}}

    {{#if values.imap}}
    <input type="hidden" name="imap" value="on">

    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-header">
            <h6 class="card-title text-primary">IMAP</h6>
        </div>

        <div class="card-body space-y-4">

            {{#unless values.imap_disabled}}
            {{#unless values.oauth2}}

            {{> ui/form-field id="imap_auth_user" label="Username" value=values.imap_auth_user error=errors.imap_auth_user lpignore=true required=true}}

            {{> ui/form-field id="imap_auth_pass" type="password" label="Password" value=values.imap_auth_pass error=errors.imap_auth_pass lpignore=true placeholder=(when hasIMAPPass "Password saved") hint="Leave blank to keep the current IMAP password."}}

            {{> ui/form-field id="imap_host" label="Hostname" value=values.imap_host error=errors.imap_host lpignore=true required=true}}
            {{> ui/form-field id="imap_port" type="number" label="Port" value=values.imap_port error=errors.imap_port lpignore=true required=true}}

            {{> ui/checkbox id="imap_secure" label="Use direct TLS" checked=values.imap_secure error=errors.imap_secure tooltip="Usually enabled for port 993. When disabled, EmailEngine uses STARTTLS if the server supports it."}}

            {{> ui/checkbox id="imap_tls_ignoreCertErrors" label="Allow invalid certificates" checked=values.imap_tls_ignoreCertErrors error=errors.imap_tls_ignoreCertErrors tooltip="Accept self-signed or otherwise invalid TLS certificates when connecting to the IMAP server of this account. The Allow Insecure Email Certificates option on the Security configuration page applies the same override to all accounts."}}

            {{> ui/checkbox id="imap_disableIMAP4rev2" label="Disable IMAP4rev2" checked=values.imap_disableIMAP4rev2 error=errors.imap_disableIMAP4rev2 tooltip="Do not use the IMAP4rev2 protocol revision even if the server supports it. Enable this option if the server advertises IMAP4rev2 but fails when EmailEngine uses it."}}

            {{/unless}}

            {{> ui/form-field id="imap_sentMailPath" label="Sent Mail folder" value=values.imap_sentMailPath error=errors.imap_sentMailPath lpignore=true placeholder='Folder path like "Sent Mail"' list="available-paths-list" hint='Store copies of sent emails in this folder. Leave blank to use the default "Sent Mail" folder for this account.'}}

            {{> ui/form-field id="imap_resyncDelay" type="number" label="Resync interval (seconds)" value=values.imap_resyncDelay error=errors.imap_resyncDelay lpignore=true hint="Time between full mailbox syncs. Leave blank to keep the current interval."}}

            {{/unless}}

            {{> ui/checkbox id="imap_disabled" label="Disable IMAP" checked=values.imap_disabled error=errors.imap_disabled tooltip="Stop syncing this mailbox while keeping the account available for sending email."}}

        </div>
    </div>
    {{/if}}

    {{#if values.smtp}}
    <input type="hidden" name="smtp" value="on">

    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-header">
            <h6 class="card-title text-primary">SMTP</h6>
        </div>

        <div class="card-body space-y-4">

            {{> ui/form-field id="smtp_auth_user" label="Username" value=values.smtp_auth_user error=errors.smtp_auth_user lpignore=true required=true}}

            {{> ui/form-field id="smtp_auth_pass" type="password" label="Password" value=values.smtp_auth_pass error=errors.smtp_auth_pass lpignore=true placeholder=(when hasSMTPPass "Password saved") hint="Leave blank to keep the current SMTP password."}}

            {{> ui/form-field id="smtp_host" label="Hostname" value=values.smtp_host error=errors.smtp_host lpignore=true required=true}}
            {{> ui/form-field id="smtp_port" type="number" label="Port" value=values.smtp_port error=errors.smtp_port lpignore=true required=true}}

            {{> ui/checkbox id="smtp_secure" label="Use direct TLS" checked=values.smtp_secure error=errors.smtp_secure tooltip="Usually enabled for port 465. When disabled, EmailEngine uses STARTTLS if the server supports it."}}

            {{> ui/checkbox id="smtp_tls_ignoreCertErrors" label="Allow invalid certificates" checked=values.smtp_tls_ignoreCertErrors error=errors.smtp_tls_ignoreCertErrors tooltip="Accept self-signed or otherwise invalid TLS certificates when connecting to the SMTP server of this account. The Allow Insecure Email Certificates option on the Security configuration page applies the same override to all accounts."}}

        </div>
    </div>
    {{/if}}

    {{/unless}}

    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-header">
            <h6 class="card-title text-primary">Advanced settings</h6>
        </div>

        <div class="card-body space-y-4">

            {{#> ui/form-field id="proxy" label="Proxy URL" error=errors.proxy hint="Use a custom proxy for this account. Start the URL with http://, https://, socks://, socks4://, or socks5://."}}
            <input type="text" class="input or-else-all{{#if errors.proxy}} is-invalid{{/if}}" id="proxy"
                placeholder="Connection URL like &quot;socks://localhost:1080&quot;&mldr;" value="{{values.proxy}}"
                name="proxy" data-target="proxy-status">
            {{/ui/form-field}}

            <div>
                {{> ui/setting-ref name="smtpEhloName"}}
                {{> ui/form-field id="smtpEhloName" label="SMTP greeting hostname" value=values.smtpEhloName error=errors.smtpEhloName placeholder="mail.example.com"}}
                <span class="helper-text">Hostname to use for the SMTP EHLO/HELO greeting. Leave empty to use the
                    default <code>{{defaultSmtpEhloName}}</code>. If you are using a dedicated IP address, the hostname
                    of that IP is preferred over this value.</span>
            </div>

            {{!-- block form: the hint carries a link, which the escaped hint= param cannot --}}
            {{#> ui/form-field id="webhooks" label="Webhook URL" error=errors.webhooks}}
            <input type="text" class="input{{#if errors.webhooks}} is-invalid{{/if}}" id="webhooks" name="webhooks"
                {{#if values.webhooks}}value="{{values.webhooks}}" {{/if}}placeholder='URL like "https://myservice.com/imap/webhooks"'>
            <span class="helper-text">Account-specific webhook URL. If set and <a href="/admin/config/webhooks"
                    class="link link-animated">webhooks</a> are enabled, EmailEngine will send webhook requests for
                events related to this account to this URL instead of the default webhook URL. Leave empty to
                clear.</span>
            {{/ui/form-field}}

            {{#> ui/form-field id="customHeaders" label="Custom webhook headers" error=errors.customHeaders hint="Enter one header per line in Header-Name: value format. These headers are sent with webhooks for this account."}}
            <textarea class="textarea font-mono w-full{{#if errors.customHeaders}} is-invalid{{/if}}" id="customHeaders"
                name="customHeaders" rows="5" spellcheck="false" data-enable-grammarly="false"
                placeholder="Custom headers like &quot;Authorization: Bearer secret_token&quot;&mldr;">{{values.customHeaders}}</textarea>
            {{/ui/form-field}}

        </div>
    </div>

    <div class="mb-6">
        {{> ui/btn label="Save changes" type="submit" icon="icon-[tabler--device-floppy]"}}
    </div>
</form>


<input type="hidden" id="availablePaths" value="{{availablePaths}}">

<script data-cfasync="false" nonce="{{cspNonce}}">
    document.addEventListener('DOMContentLoaded', () => {
        let availablePaths = JSON.parse(document.getElementById('availablePaths').value);
        // native datalist suggestions for the Sent Mail folder input (the
        // form-field markup references the list id directly)
        uiDatalist('available-paths-list', availablePaths);
    })
</script>
