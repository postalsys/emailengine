{{!--
    ui/picker - a search box that becomes a card: the shared markup behind ui/account-picker and
    ui/model-picker, which are the two faces a page asks for by name. static/js/ui.js wires every
    [data-picker] element with the adapter its kind names (see uiPickerAdapters there).

    The posted value stays a plain id in a hidden input carrying the given id, so a page that
    already reads or watches that field keeps working - ui.js fires `input` and `change` on it
    whenever the choice changes, exactly as typing into a text field would.

    Params:
      kind        - "account" or "model" (required)
      id          - hidden input id, also the default posted name and what page scripts read (required)
      name        - posted field name (defaults to id)
      label       - field label (optional)
      hint        - muted helper text under the control (optional)
      error       - validation error message (optional)
      value       - current id (optional)
      selected    - the entry for `value`, when the server resolved it (optional)
      models      - the list for the model kind: {id, name, description, recommended} entries
      placeholder - search box placeholder (required; the wrappers supply the default of their kind)
--}}
<div class="w-full">
    {{#if label}}
    <label class="label-text" for="{{id}}-search">{{label}}</label>
    {{/if}}
    <div data-picker="{{kind}}" data-input="{{id}}" {{#if models}}data-models="{{json models}}" {{/if}}{{#if selected}}data-selected="{{json selected}}" {{/if}}>
        <input type="hidden" id="{{id}}" name="{{#if name}}{{name}}{{else}}{{id}}{{/if}}" {{#if value}}value="{{value}}" {{/if}}>

        {{!-- The picked entry. Empty until ui.js paints it, and hidden whenever nothing is picked. --}}
        <div class="ee-account-picker-card hidden" data-picker-card></div>

        <div class="ee-account-picker-search" data-picker-search>
            <div class="input{{#if error}} is-invalid{{/if}}">
                <span class="icon-[tabler--search] text-base-content/60 my-auto me-2 size-4 shrink-0"></span>
                <input type="text" class="grow" id="{{id}}-search" role="combobox" aria-expanded="false" aria-autocomplete="list"
                    aria-controls="{{id}}-results" autocomplete="off" data-lpignore="true" placeholder="{{placeholder}}">
            </div>
            <div class="ee-account-picker-results hidden" id="{{id}}-results" role="listbox" data-picker-results></div>
        </div>
    </div>
    {{#if error}}
    <span class="helper-text text-error">{{error}}</span>
    {{/if}}
    {{#if hint}}
    <span class="helper-text">{{hint}}</span>
    {{/if}}
</div>
