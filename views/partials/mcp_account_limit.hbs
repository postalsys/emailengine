{{!--
    The "Limit to one account" field, offered identically by the OAuth consent prompt and the
    admin token generator so the two cannot drift on the wording - the same reason
    mcp_access_levels.hbs exists. Reads accountOptions from the page context.
    Params:
      id    - input id, also the posted field name (required)
      list  - datalist id, unique per page (required)
      value - current value, for validation re-renders (optional)
      error - validation error message (optional)
--}}
{{> ui/form-field id=id label="Limit to one account" value=value error=error list=list placeholder="account id"
    hint="Recommended. The token then only reaches this account. Leave empty to allow every account on the instance."}}
<datalist id="{{list}}">
    {{#each accountOptions}}
    <option value="{{account}}">{{label}}</option>
    {{/each}}
</datalist>
