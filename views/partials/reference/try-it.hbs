{{!--
    reference/try-it - live request runner for one operation.

    The form is rendered server-side (one field per parameter, prefilled from the
    schema example) and static/js/reference.js reads it to build and send the request.
    Requests go to this same instance, so they need a real access token - the shared
    token field at the top of the page feeds every panel.

    The request body textarea stays in the server-rendered HTML and remains the value
    everything downstream reads - the submit path, "Copy as curl" and the JSON validation.
    static/js/reference.js upgrades it to an ACE editor and syncs back into it, so the panel
    works unchanged with no JS and the editor is purely additive.

    That upgrade is deliberately lazy on both axes. ace.js is 127 KB gzipped and no
    reference page loads it otherwise, so it is fetched only once someone opens a Try it
    panel that has a body; and the editor is mounted per panel on first open, because these
    disclosures start closed and ACE cannot size itself in a container with no layout box.
    Between them a tag page mounts one or two editors rather than the seven its bodies would
    suggest, and a reader who never opens Try it pays nothing.

    Context is an operation view model from lib/api-reference/model.js.
--}}
{{#> reference/disclosure label="Try it" primary=true elId=(concat "try-" id) class="mt-4"}}

<form class="ee-ref-try border-base-content/20 mt-3 rounded-box border p-4" data-method="{{method}}" data-path="{{path}}">

    {{#> ui/alert-banner variant="warning"}}
    <div class="text-sm">Requests run against this EmailEngine instance with real data. A
        <code class="ee-code">{{methodLabel}}</code> here has the same effect as calling the API directly.
    </div>
    {{/ui/alert-banner}}

    {{#if pathParams.length}}
    <div class="mb-3 grid gap-3 sm:grid-cols-2">
        {{#each pathParams}}{{> reference/try-field}}{{/each}}
    </div>
    {{/if}}

    {{#if queryParams.length}}
    <div class="mb-3">
        {{> reference/section-heading label="Query" class="mb-2"}}
        <div class="grid gap-3 sm:grid-cols-2">
            {{#each queryParams}}{{> reference/try-field}}{{/each}}
        </div>
    </div>
    {{/if}}

    {{#if headerParams.length}}
    <div class="mb-3">
        {{> reference/section-heading label="Headers" class="mb-2"}}
        <div class="grid gap-3 sm:grid-cols-2">
            {{#each headerParams}}{{> reference/try-field}}{{/each}}
        </div>
    </div>
    {{/if}}

    {{!-- Not a <label> wrapper: reference.js replaces the textarea with an ACE mount, which a
          label cannot legitimately wrap. The heading is tied to the field by aria-label
          instead, which survives the swap. data-schema names the rendered property tree the
          completer harvests field names from - already on the page, so nothing is duplicated
          into the markup for it. --}}
    {{#if body}}
    <div class="mb-3" data-body-field data-schema="{{body.scopeId}}">
        {{> reference/section-heading label="Request body" suffix=body.contentType}}
        <textarea class="textarea mt-1 font-mono text-xs" rows="10" data-body spellcheck="false"
            aria-label="Request body">{{body.exampleJson}}</textarea>
    </div>
    {{/if}}

    {{!-- id="" on both: ui/btn reads `id`, and Handlebars merges a partial's hash params into
          the caller's context, so without it every button here would carry the surrounding
          operation's id (the same trap reference/disclosure documents). --}}
    <div class="flex flex-wrap items-center gap-3">
        {{> ui/btn label="Send request" variant="primary" size="sm" icon="icon-[tabler--send]" type="submit" id="" class=""}}
        {{!-- The code samples above are built from the schema examples; this one is built from
              whatever is in the fields right now, so what you read is what you would run. The
              token is emitted as $EMAILENGINE_TOKEN, never the live one. --}}
        {{> ui/btn label="Copy as curl" bare=true style="text" size="sm" icon="icon-[tabler--copy]" class="ee-ref-try-curl" id=""}}
        <span class="ee-ref-try-status text-base-content/60 text-sm"></span>
    </div>

    <div class="ee-ref-try-result mt-4 hidden">
        <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="ee-ref-try-code badge badge-sm"></span>
            <span class="ee-ref-try-time text-base-content/50 text-xs"></span>
        </div>
        <pre class="ee-code-block"><code class="ee-ref-try-body language-json"></code></pre>
    </div>

</form>

{{/reference/disclosure}}
