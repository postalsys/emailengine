{{!-- One OAuth2 application's sign-in button on the hosted setup form, shared by the provider
picker (accounts/register/index) and the sign-in page on the IMAP path
(accounts/register/provider-signin). Posts the signed data/sig blob back to /accounts/new with the
application as the type. Parameters: app, title (shown above the button when set), crumb, data,
sig, and optionally loginHint (the address to prefill on the provider's sign-in form). The
ee-provider-titled hover highlight ties a title and its button visually together. --}}
<div class="ee-provider{{#if title}} ee-provider-titled{{/if}}">

    {{#if title}}
    <h5 class="ee-provider-title">{{title}}</h5>
    {{/if}}

    <form method="post" action="/accounts/new">
        <input type="hidden" name="crumb" value="{{crumb}}">
        <input type="hidden" name="type" value="{{app.id}}">
        <input type="hidden" name="data" value="{{data}}">
        <input type="hidden" name="sig" value="{{sig}}">
        {{#if loginHint}}
        <input type="hidden" name="loginHint" value="{{loginHint}}">
        {{/if}}

        {{#if app.providerData.linkImage}}
        <input type="image" src="{{app.providerData.linkImage}}" class="ee-provider-image" alt="{{app.providerData.comment}}" />
        {{else}}
        <button type="submit" class="ee-btn ee-btn-primary ee-btn-block ee-btn-xl">
            <span class="ee-icon {{app.providerData.publicIcon}}"></span> {{app.providerData.comment}}
        </button>
        {{/if}}
    </form>
</div>
