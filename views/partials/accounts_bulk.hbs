{{!-- Bulk actions for the accounts list (accounts index only), on ui/bulk-actions. Each action
      posts one account at a time to POST /admin/accounts/{account}/bulk.
      Context: showPaging (the filter matches more accounts than this page shows) and matching
      (how many it matches), from the accounts index view. --}}
{{#> ui/bulk-actions endpoint="/admin/accounts/:id/bulk" one="account" many="accounts" morePages=showPaging matching=matching revoke=true}}
<button type="button" class="btn btn-text btn-sm max-sm:px-2" data-bulk-action="reconnect" title="Reconnect">
    <span class="icon-[tabler--refresh] size-4 shrink-0"></span><span class="max-sm:sr-only">Reconnect</span>
</button>
<button type="button" class="btn btn-text btn-sm max-sm:px-2" data-bulk-action="pause" title="Pause"
    data-confirm="Stop syncing {count}? IMAP accounts can still send. Use Resume to turn syncing back on.">
    <span class="icon-[tabler--player-pause] size-4 shrink-0"></span><span class="max-sm:sr-only">Pause</span>
</button>
<button type="button" class="btn btn-text btn-sm max-sm:px-2" data-bulk-action="resume" title="Resume">
    <span class="icon-[tabler--player-play] size-4 shrink-0"></span><span class="max-sm:sr-only">Resume</span>
</button>
<button type="button" class="btn btn-text btn-sm max-sm:px-2 text-error" data-bulk-action="delete" title="Delete" data-typed="delete" data-danger="1"
    data-confirm="Delete {count} from EmailEngine? This removes their synced data, account-specific templates, access tokens and queued emails. Emails on the mail server are not deleted. This cannot be undone.">
    <span class="icon-[tabler--trash] size-4 shrink-0"></span><span class="max-sm:sr-only">Delete</span>
</button>
{{/ui/bulk-actions}}
