{{#> ui/page-header title="Webhook Routes" icon="icon-[tabler--webhook]" subtitle="Filter email events, customize their payloads, and send them to your chosen URLs." badgeLabel=total badgeVariant="neutral" class="mb-6"}}
{{> ui/btn href=newLink label="Create webhook route" icon="icon-[tabler--plus]"}}
{{/ui/page-header}}

{{> ui/search-crumb parentHref="/admin/webhooks" parentLabel="Webhook Routes" query=query}}

{{#unless webhooksEnabled}}
<div class="alert alert-soft alert-warning mb-6"><span><strong>Note:</strong> Webhooks are disabled
        for EmailEngine.
        <a href="/admin/config/webhooks" class="link link-animated">Enable webhooks in configuration
            settings</a>.</span></div>
{{/unless}}

{{#if webhooks}}
<div class="card bg-base-100 shadow-md mb-6">
    <div class="overflow-x-auto">
        <table class="table ee-table-stack">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Triggered</th>
                    <th>Status</th>
                    <th class="w-12"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>

            <tbody>
                {{#each webhooks}}
                <tr class="hover:bg-base-200/60">
                    <td class="relative">
                        {{> ui/row-link href=(concat "/admin/webhooks/webhook/" id) label="Open webhook route"}}
                        <div><strong>{{name}}</strong></div>
                        {{> ui/entity-id id=id label="Webhook Route ID"}}
                    </td>

                    <td class="relative" data-label="Description">
                        {{> ui/row-link href=(concat "/admin/webhooks/webhook/" id)}}{{description}}
                    </td>

                    <td class="relative" data-label="Triggered">
                        {{> ui/row-link href=(concat "/admin/webhooks/webhook/" id)}}{{tcount}}
                    </td>

                    <td class="relative" data-label="Status">
                        {{> ui/row-link href=(concat "/admin/webhooks/webhook/" id)}}
                        {{#if enabled}}

                        {{#if webhookErrorFlag.message}}
                        {{> ui/badge label="Failing" variant="error" class="" icon="" soft=""}}
                        {{else}}
                        {{> ui/badge label="Enabled" variant="success" class="" icon="" soft=""}}
                        {{/if}}
                        {{else}}
                        {{> ui/badge label="Disabled" variant="warning" class="" icon="" soft=""}}
                        {{/if}}
                    </td>

                    <td class="ee-stack-actions relative text-end">
                        {{> ui/row-actions openHref=(concat "/admin/webhooks/webhook/" id) label="Webhook route actions"
                        deleteModal="#deleteWebhook" deleteId=id deleteName=name}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    {{> ui/pagination showPaging=showPaging prevPage=prevPage nextPage=nextPage pageLinks=pageLinks}}
</div>
{{else}}
{{> ui/list-empty noun="webhook routes" query=query firstPage=firstPage createHref=newLink createLabel="Create your first webhook route" clearHref="/admin/webhooks"}}
{{/if}}

{{#> ui/details summary="How webhook routes work" class="card bg-base-100 shadow-md mb-6"}}
<div>
    <p class="mb-2">
        Each enabled route evaluates events with its filter function. When the filter returns <code>true</code>,
            EmailEngine sends the event to the route's target URL. Add a map function to change the payload format.
            Routes run independently of the default webhook target and its event selection.
    </p>
    <p class="mb-0"><a href="https://learn.emailengine.app/docs/integrations/low-code" target="_blank"
            rel="noopener noreferrer" referrerpolicy="no-referrer" class="link link-animated">Learn more about webhook
            routes</a>.</p>
</div>
{{/ui/details}}

{{> ui/delete-modal id="deleteWebhook" noun="webhook route" action="/admin/webhooks/delete" fieldName="webhook"}}
