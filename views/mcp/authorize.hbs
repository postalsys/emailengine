{{!-- The human decision point of the MCP OAuth flow, rendered in the chrome-free `prompt`
      layout so it reads as a consent dialog rather than a settings page. The operator arrives
      here from an MCP client, decides, and leaves - the admin navigation would only suggest
      this is a place to stay. --}}

{{#if errorMessage}}

<div class="text-center">
    <div class="bg-warning/10 text-warning mx-auto mb-4 flex size-12 items-center justify-center rounded-full">
        <span class="icon-[tabler--plug-connected-x] size-6"></span>
    </div>
    <h1 class="text-base-content mb-2 text-xl font-semibold">Cannot authorize this client</h1>
    <p class="text-base-content/60 mb-6 text-sm">{{errorMessage}}</p>
    <a href="/admin" class="link link-animated text-sm">Go to the EmailEngine dashboard</a>
</div>

{{else}}

<div class="mb-6 text-center">
    <div class="bg-primary/10 text-primary mx-auto mb-4 flex size-12 items-center justify-center rounded-full">
        <span class="icon-[tabler--plug-connected] size-6"></span>
    </div>
    <h1 class="text-base-content text-xl font-semibold">{{clientName}} wants to connect
        {{!-- The same Beta label the config page, the side menu and the token form carry. This is
              the one MCP surface a person can reach without passing one of those first, so it is
              also the one where the label would otherwise be missing. --}}
        {{> ui/badge label="Beta" variant="info" soft=true class="badge-sm align-middle"}}</h1>
    <p class="text-base-content/60 mt-2 text-sm">An MCP client is asking for access to the email accounts on this
        EmailEngine instance. Once you decide, the browser returns to <code>{{redirectHost}}</code>.</p>
</div>

{{#unless canProvision}}
<div class="alert alert-soft alert-warning mb-6 text-sm">
    <span class="icon-[tabler--lock] size-5 shrink-0"></span>
    <span>Authorizing a client requires an authenticated admin session.
        <a href="/admin/account/password" target="_blank" rel="noopener noreferrer" class="link">Set an admin
            password</a> and sign in first - otherwise this request can only be denied.</span>
</div>
{{/unless}}

<form method="post" action="/admin/mcp/authorize">
    <input type="hidden" name="crumb" value="{{crumb}}" />
    <input type="hidden" name="client_id" value="{{values.client_id}}" />
    <input type="hidden" name="redirect_uri" value="{{values.redirect_uri}}" />
    <input type="hidden" name="state" value="{{values.state}}" />
    <input type="hidden" name="code_challenge" value="{{values.code_challenge}}" />
    <input type="hidden" name="resource" value="{{values.resource}}" />

    <div class="space-y-4">

        <fieldset class="space-y-2">
            <legend class="label-text mb-1">Access level</legend>
            {{> mcp_access_levels name="access" idPrefix="access" selected=accessLevel}}
        </fieldset>

        {{!-- The grant word lists come from MCP_GRANT_WORDING (derived from SURFACE_GRANTS.mcp,
              never written out here), so this screen cannot promise less than the token grants
              after the tool set changes. The framing prose around them is bespoke per level - a
              level added to MCP_ACCESS_LEVELS needs its own alert block here. One is visible at
              a time - the one describing the selected access level. --}}
        <div data-access="read" class="consent-grant alert alert-soft alert-info text-sm{{#equals accessLevel 'read'}}{{else}} hidden{{/equals}}">
            <span class="icon-[tabler--info-circle] size-5 shrink-0"></span>
            <span>Through the MCP tool set the client will be able to <strong>{{grantWording.read.actions}}</strong>
                {{grantWording.read.groups}} on the accounts its token can reach. It cannot send email, delete anything,
                change anything, read stored credentials, or change instance settings.</span>
        </div>

        <div data-access="mail" class="consent-grant alert alert-soft alert-warning text-sm{{#equals accessLevel 'mail'}}{{else}} hidden{{/equals}}">
            <span class="icon-[tabler--alert-triangle] size-5 shrink-0"></span>
            <span>Through the MCP tool set the client will be able to <strong>{{grantWording.mail.actions}}</strong>
                across {{grantWording.mail.groups}} on the accounts its token can reach - everything except the delete
                tool. Instructions inside received mail are a real prompt-injection risk once sending is granted. It
                cannot read stored credentials or change instance settings.</span>
        </div>

        <div data-access="full" class="consent-grant alert alert-soft alert-warning text-sm{{#equals accessLevel 'full'}}{{else}} hidden{{/equals}}">
            <span class="icon-[tabler--alert-triangle] size-5 shrink-0"></span>
            <span>Through the MCP tool set the client will be able to <strong>{{grantWording.full.actions}}</strong>
                across {{grantWording.full.groups}} on the accounts its token can reach. Instructions inside received
                mail are a real prompt-injection risk once sending is granted. It cannot read stored credentials or
                change instance settings.</span>
        </div>

        <div>
            {{> mcp_account_limit id="account" value=values.account selected=selectedAccount error=errors.account}}
        </div>

        {{!-- The grant sentences above say what a level allows in the permission vocabulary; this
              says which tools the client ends up holding, which is closer to the thing being
              approved. Follows the account field too, because limiting the client to one account
              takes the instance-wide tools away from it. --}}
        {{> mcp_tool_count id="consentToolCount" levelName="access" accountId="account"}}

        <div class="flex gap-3 pt-2">
            <button type="submit" name="decision" value="deny" class="btn btn-neutral btn-outline grow">
                <span class="icon-[tabler--x] size-4 shrink-0"></span>Deny
            </button>
            {{!-- Denying needs no admin session, so that button works in every state the page
                  renders in --}}
            {{#if canProvision}}
            <button type="submit" name="decision" value="approve" class="btn btn-primary grow">
                <span class="icon-[tabler--check] size-4 shrink-0"></span>Approve
            </button>
            {{/if}}
        </div>

        <p class="text-base-content/60 text-center text-xs">Approving creates an access token with the <code>mcp</code>
            scope - it appears on the <a href="/admin/tokens?scope=mcp" class="link">Access Tokens</a> page and can be
            revoked there at any time.</p>

    </div>
</form>

<script>
    (() => {
        // The grant sentences describe the same token under each setting of the radio, so
        // whichever is showing is the one the operator is about to approve
        let radios = Array.from(document.querySelectorAll('input[name="access"]'));
        let grants = Array.from(document.querySelectorAll('.consent-grant'));

        let sync = () => {
            let selected = radios.find(radio => radio.checked);
            let access = (selected && selected.value) || 'read';
            grants.forEach(grant => grant.classList.toggle('hidden', grant.dataset.access !== access));
        };

        radios.forEach(radio => radio.addEventListener('change', sync));
        sync();
    })();
</script>

{{/if}}
