{{!-- The human decision point of the MCP OAuth flow, rendered in the chrome-free `prompt`
      layout so it reads as a consent dialog rather than a settings page. The operator arrives
      here from an MCP client, decides, and leaves - the admin navigation would only suggest
      this is a place to stay. --}}

{{#if errorMessage}}

<div class="text-center">
    <div class="bg-warning/10 text-warning mx-auto mb-4 flex size-12 items-center justify-center rounded-full">
        <span class="icon-[tabler--plug-connected-x] size-6"></span>
    </div>
    <h1 class="text-base-content mb-2 text-xl font-semibold">Cannot authorize this client</h1>
    <p class="text-base-content/60 mb-6 text-sm">{{errorMessage}}</p>
    <a href="/admin" class="link link-animated text-sm">Go to the EmailEngine dashboard</a>
</div>

{{else}}

<div class="mb-6 text-center">
    <div class="bg-primary/10 text-primary mx-auto mb-4 flex size-12 items-center justify-center rounded-full">
        <span class="icon-[tabler--plug-connected] size-6"></span>
    </div>
    <h1 class="text-base-content text-xl font-semibold">{{clientName}} wants to connect
        {{!-- The same Beta label the config page, the side menu and the token form carry. This is
              the one MCP surface a person can reach without passing one of those first, so it is
              also the one where the label would otherwise be missing. --}}
        {{> ui/badge label="Beta" variant="info" soft=true class="badge-sm align-middle"}}</h1>
    <p class="text-base-content/60 mt-2 text-sm">An MCP client is asking for access to this EmailEngine instance. Decide
        what it may manage and whether it may read mail; once you decide, the browser returns to
        <code>{{redirectHost}}</code>.</p>
</div>

{{#unless canProvision}}
<div class="alert alert-soft alert-warning mb-6 text-sm">
    <span class="icon-[tabler--lock] size-5 shrink-0"></span>
    <span>Authorizing a client requires an authenticated admin session.
        <a href="/admin/account/password" target="_blank" rel="noopener noreferrer" class="link">Set an admin
            password</a> and sign in first - otherwise this request can only be denied.</span>
</div>
{{/unless}}

<form method="post" action="/admin/mcp/authorize">
    <input type="hidden" name="crumb" value="{{crumb}}" />
    <input type="hidden" name="client_id" value="{{values.client_id}}" />
    <input type="hidden" name="redirect_uri" value="{{values.redirect_uri}}" />
    <input type="hidden" name="state" value="{{values.state}}" />
    <input type="hidden" name="code_challenge" value="{{values.code_challenge}}" />
    <input type="hidden" name="resource" value="{{values.resource}}" />

    <div class="space-y-5">

        {{!-- Management first: it is what the endpoint is for by default, and the section a
              client that asked for nothing in particular gets. --}}
        <fieldset class="space-y-2">
            <legend class="label-text mb-1">{{mcpSections.manage.label}}</legend>
            {{> mcp_access_levels section=mcpSections.manage name="manage" idPrefix="manage" selected=manageLevel includeNone=true}}
        </fieldset>

        {{!-- One alert per level, generated from the table rather than written per level: the
              grant word lists come from the surface tables the enforcement reads (never written
              out here), so this screen cannot promise less than the token grants after the tool
              set changes, and the caveat travels with the level it describes. One is visible at
              a time - the one describing the selected level. --}}
        {{#each mcpSections.manage.options}}
        <div data-section="manage" data-level="{{value}}"
            class="consent-grant alert alert-soft {{#equals value 'observe'}}alert-info{{else}}alert-warning{{/equals}} text-sm{{#equals ../manageLevel value}}{{else}} hidden{{/equals}}">
            <span class="{{#equals value 'observe'}}icon-[tabler--info-circle]{{else}}icon-[tabler--alert-triangle]{{/equals}} size-5 shrink-0"></span>
            <span>Through the management tools the client will be able to <strong>{{actions}}</strong> across
                {{groups}}. {{caveat}}</span>
        </div>
        {{/each}}

        {{!-- Mail is the opt-in half: off unless the person ticks it, or the client asked for the
              mail scope (which only pre-ticks the box). The levels sit in an element named after
              the checkbox with "Levels" appended - the convention static/js/ui.js shows and hides
              them by. --}}
        <fieldset class="space-y-2">
            <legend class="label-text mb-1">{{mcpSections.mail.label}}</legend>
            {{> ui/checkbox id="mailEnabled" label=mcpSections.mail.toggle.label checked=mailEnabled hint=mcpSections.mail.toggle.hint}}
            <div id="mailEnabledLevels" class="ps-6 space-y-2{{#unless mailEnabled}} hidden{{/unless}}">
                {{> mcp_access_levels section=mcpSections.mail name="mailLevel" idPrefix="mailLevel" selected=mailLevel}}
            </div>
        </fieldset>

        {{#each mcpSections.mail.options}}
        <div data-section="mail" data-level="{{value}}"
            class="consent-grant alert alert-soft {{#equals value 'read'}}alert-info{{else}}alert-warning{{/equals}} text-sm{{#if ../mailEnabled}}{{#equals ../mailLevel value}}{{else}} hidden{{/equals}}{{else}} hidden{{/if}}">
            <span class="{{#equals value 'read'}}icon-[tabler--info-circle]{{else}}icon-[tabler--alert-triangle]{{/equals}} size-5 shrink-0"></span>
            <span>Through the mail tools the client will be able to <strong>{{actions}}</strong> across {{groups}} on
                the accounts its token can reach. {{caveat}}</span>
        </div>
        {{/each}}

        {{#if errors.access}}
        <div class="alert alert-soft alert-error text-sm">
            <span class="icon-[tabler--alert-circle] size-5 shrink-0"></span>
            <span>{{errors.access}}</span>
        </div>
        {{/if}}

        <div>
            {{> mcp_account_limit id="account" value=values.account selected=selectedAccount error=errors.account}}
        </div>

        {{!-- The grant sentences above say what a level allows in the permission vocabulary; this
              says which tools the client ends up holding, which is closer to the thing being
              approved. Follows the account field too, because limiting the client to one account
              takes the instance-wide tools away from it - what is left of a management grant is
              then the tools that operate that one account. --}}
        {{> mcp_tool_count id="consentToolCount" manageName="manage" mailName="mailLevel" mailToggle="mailEnabled" accountId="account"}}

        <div class="flex gap-3 pt-2">
            <button type="submit" name="decision" value="deny" class="btn btn-neutral btn-outline grow">
                <span class="icon-[tabler--x] size-4 shrink-0"></span>Deny
            </button>
            {{!-- Denying needs no admin session, so that button works in every state the page
                  renders in --}}
            {{#if canProvision}}
            <button type="submit" name="decision" value="approve" class="btn btn-primary grow">
                <span class="icon-[tabler--check] size-4 shrink-0"></span>Approve
            </button>
            {{/if}}
        </div>

        {{!-- The lifecycle is revocation, not expiry: this flow issues no refresh token and sets no
              TTL, so an approved client holds its token until someone takes it away. Said here
              because this is the screen where the decision is made, and the person making it has
              no other place to learn it. --}}
        <p class="text-base-content/60 text-center text-xs">Approving creates an access token with the MCP scopes you
            chose (<code>mcp-manage</code> for the instance, <code>mcp</code> for mail) and exactly the grants shown
            above. It does not expire - it appears on the <a href="/admin/tokens?scope=mcp-manage&amp;scope=mcp"
                class="link">Access Tokens</a> page and stays valid until you revoke it there.</p>

    </div>
</form>

<script data-cfasync="false" nonce="{{cspNonce}}">
    (() => {
        // The grant sentences describe the same token under each setting of the controls, so
        // whichever are showing are the ones the operator is about to approve. The tool count and
        // the mail levels' visibility are wired by ui.js off the count element's data attributes.
        let manageRadios = Array.from(document.querySelectorAll('input[name="manage"]'));
        let mailRadios = Array.from(document.querySelectorAll('input[name="mailLevel"]'));
        let mailToggle = document.getElementById('mailEnabled');
        let grants = Array.from(document.querySelectorAll('.consent-grant'));

        let sync = () => {
            let manage = (manageRadios.find(radio => radio.checked) || {}).value || 'none';
            let mail = mailToggle.checked ? (mailRadios.find(radio => radio.checked) || {}).value || 'none' : 'none';
            grants.forEach(grant => {
                let level = grant.dataset.section === 'manage' ? manage : mail;
                grant.classList.toggle('hidden', grant.dataset.level !== level);
            });
        };

        manageRadios.concat(mailRadios).forEach(radio => radio.addEventListener('change', sync));
        mailToggle.addEventListener('change', sync);
        sync();
    })();
</script>

{{/if}}
