{{> ui/page-header title="Upgrade instructions" icon="icon-[tabler--settings]" class="mb-1"}}

{{#unless isRender}}
{{#> ui/stat-card variant="info" icon="icon-[tabler--info-circle]" class="mt-6"}}

{{#if isDO}}
<p class="mb-2">To upgrade EmailEngine to the latest version, log in to your server and run the
    following command:<br />
    <kbd class="kbd">$ sudo /opt/upgrade-emailengine.sh</kbd>
</p>
{{/if}}

{{#if isScriptInstalled}}
<p class="mb-2">To upgrade EmailEngine to the latest version, log in to your server and run the
    following command:<br />
    <kbd class="kbd">$ sudo /opt/upgrade-emailengine.sh</kbd>
</p>
{{/if}}

{{#if isGeneral}}
<p class="mb-2">To upgrade EmailEngine to the latest version, download the latest version from the <a
        href="https://emailengine.app/#downloads" target="_blank" rel="noopener noreferrer"
        referrerpolicy="no-referrer" class="link link-animated">EmailEngine's homepage</a>, replace the binary and
    restart the application.</p>
{{/if}}

{{/ui/stat-card}}
{{/unless}}

{{#if isRender}}
<div class="card bg-base-100 shadow-md mt-6 mb-6">
    <div class="card-body">
        <p class="mb-6">To upgrade EmailEngine to the latest version, log in to your Render <a
                href="https://dashboard.render.com/" target="_blank" rel="noopener noreferrer"
                referrerpolicy="no-referrer" class="link link-animated">Dashboard</a>,
            select
            EmailEngine and run a manual deploy as shown on the screenshot below.
        </p>
        <p><img src="/static/preview/render.png"
                class="border-base-content/10 rounded-box max-w-full border p-1" alt="Render manual deploy"></p>
    </div>
</div>
{{/if}}

{{#unless nodeRuntime.packaged}}
{{#> ui/card title="Node.js" id="node" class="mt-6"}}
{{#if nodeRuntime.outsideRange}}
{{#> ui/alert-banner variant="warning" class="mb-4"}}
<p>This instance runs on Node.js {{nodeRuntime.version}}, which is outside the range EmailEngine supports
    ({{nodeRuntime.supported}}). Upgrade Node.js before upgrading EmailEngine.</p>
{{/ui/alert-banner}}
{{else}}
<p class="mb-4">This instance runs on Node.js {{nodeRuntime.version}}. EmailEngine supports {{nodeRuntime.supported}}.</p>
{{/if}}

{{#if isRender}}
<p class="mb-2">Render picks the Node.js release from the <code>engines</code> field of EmailEngine's
    <code>package.json</code>, so a manual deploy of the latest version also moves Node.js.</p>
{{else}}
<p class="mb-2">On a Debian or Ubuntu server that installed Node.js from NodeSource, which includes the
    DigitalOcean one-click image, log in and run:</p>
<pre class="ee-code-block"><code>{{#each nodeRuntime.upgradeCommands}}$ {{this}}
{{/each}}</code></pre>
<p class="mt-2">Anywhere else, install a supported release with the tool Node.js came from. The
    EmailEngine binaries and the Docker image carry their own Node.js.</p>
{{/if}}
{{/ui/card}}
{{/unless}}
